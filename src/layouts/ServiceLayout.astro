---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import ProjectsGallery, { type ServiceBlock } from "@/components/ProjectsGallery.astro";
import type { GridItem } from "@/components/GridMediaItem.astro";
import Faq, { type FaqItem } from "@/components/Faq.astro";
import {
  SITE,
  SERVICES,
  CITIES,
  servicePath,
  waServiceMessage,
} from "@/config";
import type { Locale, Service } from "@/config";
import { serviceAlternates, routePath } from "@/i18n/routes";
import { cityServicePath, cityServiceLabel } from "@/i18n/city-service";
import { useT } from "@/i18n/ui";
import { servicePhotos, photoAlt } from "@/lib/photos";

interface Props {
  locale: Locale;
  service: Service;
  seoTitle: string;
  seoDescription: string;
  /** Frase editorial grande del bloque de texto ("Vuestra boda, …") */
  h1: string;
  heroIntro: string;
  bodyHtml: string;
  faqs: FaqItem[];
}

const { locale, service, seoTitle, seoDescription, h1, heroIntro, bodyHtml, faqs } = Astro.props;

// h1 con la búsqueda real ("Fotógrafo y Vídeo de Bodas en Barcelona y
// Madrid"): el <title> sin la marca. Se muestra con el estilo .eyebrow
// ya existente, sobre la frase editorial grande.
const keywordH1 = seoTitle.replace(/\s*·\s*Satori Arts\s*$/, "");
const stripHtml = (html: string) => html.replace(/<[^>]+>/g, "");
const t = useT(locale);
const copy = service.i18n[locale];

const pageUrl = new URL(servicePath(locale, service), SITE.url).href;
const alternates = serviceAlternates(service.key);

// MISMA construcción de "blocks" que PortfolioPage.astro (un único
// elemento aquí, en vez de uno por servicio) — al pasar por el mismo
// componente ProjectsGallery, esta página de servicio individual
// renderiza EXACTAMENTE la misma estructura que su categoría dentro de
// /proyectos/, sin poder divergir.
const photos: GridItem[] = servicePhotos(service.key).map((image, i) => ({
  type: "photo" as const,
  image,
  alt: photoAlt(locale, copy.title, i, image),
  key: service.key,
  href: servicePath(locale, service),
  title: copy.title,
}));
const photoColumns: [GridItem[], GridItem[]] = [[], []];
photos.forEach((p, i) => photoColumns[i % 2].push(p));

const blocks: ServiceBlock[] = [{ key: service.key, photos, photoColumns }];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("nav.home"), item: new URL(routePath(locale, "home"), SITE.url).href },
      { "@type": "ListItem", position: 2, name: copy.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: copy.title,
    description: copy.short,
    url: pageUrl,
    serviceType: copy.title,
    areaServed: CITIES.map((c) => ({ "@type": "City", name: c.name })),
    provider: { "@type": "ProfessionalService", name: SITE.brand, url: SITE.url },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: stripHtml(f.a) },
    })),
  },
];
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article>
    <!-- ProjectsGallery: MISMO componente que usa /proyectos/
         (PortfolioPage.astro) — sigue mostrando "Proyectos" a
         propósito (no el nombre del servicio), para que no "salte"
         visualmente al cambiar de pestaña entre servicios. Solo las
         pestañas difieren (enlaces reales, no radios: cada servicio es
         su propia URL indexable para el SEO local) — ver
         ProjectsGallery.astro para la explicación completa de por qué
         ese es el único punto que no se puede unificar. -->
    <ProjectsGallery locale={locale} blocks={blocks} titleAs="p">
      <Fragment slot="filters">
        <a href={routePath(locale, "portfolio")} class="btn filter-pill shrink-0">
          <span class="hover-flip">
            <span class="flip-a block">{t("portfolio.filterAll")}</span>
            <span aria-hidden="true" class="flip-b block">{t("portfolio.filterAll")}</span>
          </span>
        </a>
        {
          SERVICES.map((s) => (
            <a href={servicePath(locale, s)} class:list={["btn filter-pill shrink-0", s.key === service.key && "is-active"]}>
              <span class="hover-flip">
                <span class="flip-a block">{s.i18n[locale].title}</span>
                <span aria-hidden="true" class="flip-b block">{s.i18n[locale].title}</span>
              </span>
            </a>
          ))
        }
      </Fragment>
    </ProjectsGallery>

    <!-- TEXTO SEO del servicio (visible: Google no posiciona texto oculto).
         Sin estilos nuevos: reutiliza exactamente el patrón de las páginas
         servicio×ciudad (.reveal .prose-body .section-space
         .container-prose-left), el .eyebrow del sitio para el h1, el estilo
         del titular del manifiesto de la home para la frase grande y el
         acordeón Faq.astro ya existente. Textos en services-content.ts. -->
    <section aria-labelledby="servicio-h1" class="section-space container-prose-left">
      <div class="reveal prose-body">
        <h1 id="servicio-h1" class="eyebrow mb-4">{keywordH1}</h1>
        <p class="font-heading text-3xl font-medium text-balance text-foreground sm:text-5xl">{h1}</p>
        <p>{heroIntro}</p>
        <Fragment set:html={bodyHtml} />
        <h2>{t("service.citiesTitle")}</h2>
        <ul>
          {CITIES.map((city) => (
            <li>
              <a href={cityServicePath(locale, service.key, city)} class="underline underline-offset-4">
                {cityServiceLabel(locale, service.key, city)}
              </a>
            </li>
          ))}
        </ul>
        <h2>{t("service.faqTitle")}</h2>
      </div>
      <div class="reveal">
        <Faq items={faqs} />
      </div>
    </section>

    <!-- CTA de cierre, alineado a la izquierda (mismo eje que
         "PROYECTOS", la barra de categorías y el grid) — ver
         PortfolioPage.astro para la explicación completa de por qué ya
         no se centra en desktop como el resto de las páginas del
         sitio. -->
    <section class="section-space reveal container-tight flex flex-col items-start gap-8 text-left sm:gap-6">
      <p class="text-balance font-heading text-4xl font-medium text-foreground sm:text-3xl">{t("cta.dateQuestion")}</p>
      <WhatsAppButton size="lg" message={waServiceMessage(locale, service)} label={t("cta.book")} />
    </section>
  </article>

  <script>
    import "@/scripts/filter-scroll";
  </script>
</BaseLayout>
