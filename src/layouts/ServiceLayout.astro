---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import type { FaqItem } from "@/components/Faq.astro";
import {
  SITE,
  SERVICES,
  CITIES,
  servicePath,
  waServiceMessage,
} from "@/config";
import type { Locale, Service } from "@/config";
import { serviceAlternates, routePath } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { servicePhotos, photoAlt } from "@/lib/photos";

interface Props {
  locale: Locale;
  service: Service;
  seoTitle: string;
  seoDescription: string;
  heroIntro: string;
  faqs: FaqItem[];
}

const { locale, service, seoTitle, seoDescription, heroIntro } = Astro.props;
const t = useT(locale);
const copy = service.i18n[locale];

const pageUrl = new URL(servicePath(locale, service), SITE.url).href;
const alternates = serviceAlternates(service.key);

const photos = servicePhotos(service.key);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: t("nav.home"), item: new URL(routePath(locale, "home"), SITE.url).href },
      { "@type": "ListItem", position: 2, name: copy.title, item: pageUrl },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: copy.title,
    description: copy.short,
    url: pageUrl,
    serviceType: copy.title,
    areaServed: CITIES.map((c) => ({ "@type": "City", name: c.name })),
    provider: { "@type": "ProfessionalService", name: SITE.brand, url: SITE.url },
  },
];
---

<BaseLayout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <article>
    <!-- Cabecera: idéntica a /portfolio/ — título en mayúscula del mismo
         tamaño, y debajo las mismas pestañas (con el servicio actual
         activo). Sin párrafo, insignias ni CTA: la página queda con la
         misma diagramación exacta que Proyectos. -->
    <header class="container-tight py-16 md:py-20">
      <h1 data-reveal-words class="font-heading text-3xl font-normal uppercase text-foreground sm:text-5xl">{t("nav.portfolio")}</h1>
    </header>

    <!-- Galería: mismas pestañas y cuadrícula de 2 columnas con icono "+"
         y título + categoría bajo cada imagen, idénticas a la página
         general de Proyectos, para mantener una sola diagramación en
         todo el sitio. -->
    <section aria-label={copy.title} class="container-tight pb-16">
      <div class="reveal -mx-5 mb-10 flex flex-nowrap gap-2 overflow-x-auto px-5 sm:mx-0 sm:flex-wrap sm:px-0">
        <a href={routePath(locale, "portfolio")} class="filter-pill shrink-0">
          <span class="hover-flip">
            <span class="flip-a block">{t("portfolio.filterAll")}</span>
            <span aria-hidden="true" class="flip-b block">{t("portfolio.filterAll")}</span>
          </span>
        </a>
        {
          SERVICES.map((s) => (
            <a href={servicePath(locale, s)} class:list={["filter-pill shrink-0", s.key === service.key && "is-active"]}>
              <span class="hover-flip">
                <span class="flip-a block">{s.i18n[locale].title}</span>
                <span aria-hidden="true" class="flip-b block">{s.i18n[locale].title}</span>
              </span>
            </a>
          ))
        }
      </div>
      <div class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2">
        {
          photos.map((image, i) => (
            <div class="relative block overflow-hidden">
              <Image
                src={image}
                alt={photoAlt(locale, copy.title, i)}
                widths={[480, 768, 1024]}
                sizes="(max-width: 640px) 100vw, 50vw"
                loading="eager"
                class="aspect-[16/9] w-full object-cover"
              />
            </div>
          ))
        }
      </div>
    </section>

    <!-- CTA de cierre, centrado, como en Proyectos -->
    <section class="reveal container-tight flex flex-col items-start gap-6 py-14 text-left sm:items-center sm:py-24 md:py-32 sm:text-center">
      <p class="font-heading text-2xl font-medium text-foreground sm:text-3xl">{t("cta.dateQuestion")}</p>
      <WhatsAppButton size="lg" message={waServiceMessage(locale, service)} label={t("cta.book")} />
    </section>
  </article>
</BaseLayout>
