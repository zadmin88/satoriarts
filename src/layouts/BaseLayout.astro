---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE, LOCALE_LANG, OG_LOCALE, LOCALES } from "@/config";
import type { Locale } from "@/config";
import { businessSchema } from "@/lib/schema";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import { useT } from "@/i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Ruta equivalente en cada idioma (para hreflang y selector) */
  alternates: Record<Locale, string>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Ruta de la imagen OG (por defecto /og-image.jpg) */
  ogImage?: string;
  /** La página tiene su propia marca grande y centrada en el hero (home). */
  logoRevealsOnScroll?: boolean;
}

const {
  locale,
  title,
  description,
  alternates,
  jsonLd,
  noindex = false,
  ogImage = "/og-image.jpg",
  logoRevealsOnScroll = false,
} = Astro.props;

const t = useT(locale);
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;

// hreflang: una etiqueta por idioma + x-default apuntando a español
const hreflangs = LOCALES.map((l) => ({
  lang: LOCALE_LANG[l],
  href: new URL(alternates[l], SITE.url).href,
}));

// Combina schema del negocio + schema específico de la página
const pageSchema = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allSchema = [businessSchema(locale), ...pageSchema];
---

<!doctype html>
<html lang={LOCALE_LANG[locale]}>
  <head>
    <meta charset="UTF-8" />
    <!-- SIN viewport-fit=cover a propósito: en móviles sin notch, el
         navegador ya reserva la barra de estado (el contenido queda por
         debajo). Activar "cover" haría que el contenido se dibujara por
         DEBAJO de la barra de estado, y como env(safe-area-inset-top)=0
         sin notch, el header quedaría cortado. El header sigue con
         .site-header (padding-top:env(...)) por si algún día hay notch:
         hoy equivale a 0px, sin efecto. -->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Precarga de las 4 variantes autoalojadas de General Sans: sin
         esto, "font-display: swap" deja una ventana breve donde el
         texto (títulos, botones, filtros) se pinta con la fuente de
         reemplazo del sistema antes de cambiar a la real — y como cada
         elemento puede terminar ese cambio en un instante distinto, se
         percibe como pesos de fuente inconsistentes entre botones. -->
    <link rel="preload" href="/fonts/general-sans/GeneralSans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans/GeneralSans-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans/GeneralSans-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/general-sans/GeneralSans-700.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    {hreflangs.map((h) => <link rel="alternate" hreflang={h.lang} href={h.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, SITE.url).href} />

    <!-- favicon.ico/favicon.png/apple-touch-icon.png: el isotipo real
         (Satoriarts_Isotipo.png) es blanco sobre fondo transparente —
         invisible en la pestaña del navegador (fondo claro) o como
         ícono de iOS (no admite transparencia). Se generaron con fondo
         negro compuesto (script con "sharp"). Se añade también un
         .ico real (16/32/48px) porque algunos navegadores/Windows dan
         prioridad al .ico sobre un <link> de PNG, o directamente piden
         "/favicon.ico" por convención aunque no esté declarado. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0a0a09" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.brand} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <JsonLd data={allSchema} />
    <ClientRouter />
    <script>
      import "@/scripts/smooth-scroll";
      import "@/scripts/scroll-reveal";
      import "@/scripts/close-on-scroll";
      import "@/scripts/grayscale-tap";
    </script>
  </head>
  <!-- min-h-svh (no dvh): dvh se recalcula cuando la barra de
       direcciones/UI del navegador móvil se oculta o aparece; si el
       layout se midió con la barra oculta (dvh más alto) y luego
       reaparece al hacer scroll, queda un hueco en blanco real debajo
       del footer antes del final del documento. svh usa siempre el
       viewport más pequeño posible, así el footer queda siempre pegado
       al final real, sin hueco. -->
  <body id="top" class="flex min-h-svh flex-col">
    <a
      href="#contenido"
      class="sr-only rounded-lg bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50"
    >
      {t("a11y.skip")}
    </a>
    <Header locale={locale} alternates={alternates} logoRevealsOnScroll={logoRevealsOnScroll} />
    <main id="contenido" class="main-offset flex-1" transition:animate="fade">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
