---
import { SITE, SERVICES, servicePath, waLink, waDefaultMessage } from "@/config";
import type { Locale } from "@/config";
import { routePath } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import Logo from "@/components/Logo.astro";

interface Props {
  locale: Locale;
  alternates: Record<Locale, string>;
  /** La página ya muestra la marca grande y centrada en su propio hero
   *  (home): el logo del header nace oculto ahí y aparece con una
   *  transición sutil en cuanto se empieza a hacer scroll; a la vez,
   *  detrás del header entero aparece una barra sutil en cuanto el
   *  hero termina de salir, para que el menú quede siempre legible. */
  logoRevealsOnScroll?: boolean;
}

const { locale, alternates, logoRevealsOnScroll = false } = Astro.props;
const t = useT(locale);

// Submenú "Proyectos": las 4 verticales de servicio.
const services = SERVICES.map((s) => ({
  href: servicePath(locale, s),
  label: s.i18n[locale].title,
}));

// Menú de pantalla completa, simplificado: Inicio, Conócenos, Proyectos
// (con submenú), Journal y Contacto.
// Las etiquetas se pasan ya en mayúsculas (en vez de con text-transform
// en CSS): con acentos, aplicar "uppercase" en vivo a texto en vivo
// duplica visualmente la tilde en algunos navegadores (p. ej. "Conócenos").
const primaryNav = [
  { href: routePath(locale, "home"), label: t("nav.home").toLocaleUpperCase(locale) },
  { href: routePath(locale, "about"), label: t("nav.aboutMenu").toLocaleUpperCase(locale) },
];
const secondaryNav = [
  { href: routePath(locale, "journal"), label: t("nav.journal").toLocaleUpperCase(locale) },
];
const projectsLabel = t("nav.projects").toLocaleUpperCase(locale);

// Índice global para escalonar el revelado palabra a palabra.
let wordIndex = 0;
const wordsOf = (label: string) => label.split(" ").map((w) => ({ w, idx: wordIndex++ }));

// [Fix] "CONÓCENOS" (y cualquier palabra con vocal acentuada) mostraba
// un pequeño trazo/símbolo suelto bajo la tilde, reportado varias
// veces y no resuelto con ajustes de line-height ni de
// backface-visibility. Tras confirmar que el HTML compilado está
// limpio (sin caracteres ocultos) y que el resto de palabras del menú
// —ninguna con acento— nunca mostraba el problema, se elimina la causa
// por completo: las palabras con acento se muestran de forma estática
// (sin el "transform" del deslizamiento .word-reveal), evitando la
// combinación exacta (transform + vocal acentuada) sospechosa del bug.
const HAS_ACCENT = /[áéíóúàèìòùäëïöüñçÁÉÍÓÚÀÈÌÒÙÄËÏÖÜÑÇ]/;
---

<header class:list={["fixed top-0 inset-x-0 z-50", logoRevealsOnScroll ? "header-bar-reveal" : "bg-black"]}>
  <div class="container-tight grid h-24 grid-cols-3 items-center md:h-28">
    <!-- Izquierda: botón "Menú" (pastilla de cristal, como verostudio.com) -->
    <details class="menu group relative min-w-0 justify-self-start">
      <summary
        class="header-pill font-nav relative z-50 flex h-12 w-auto cursor-pointer list-none items-center justify-start rounded-sm uppercase leading-none text-white transition-colors select-none md:h-12 md:justify-start md:text-sm md:font-medium md:tracking-[0.06em] [&::-webkit-details-marker]:hidden"
        aria-label={t("a11y.menu")}
      >
        <!-- Móvil: icono hamburguesa (como el referente) -->
        <span class="hamburger md:hidden" aria-hidden="true">
          <span></span><span></span>
        </span>
        <!-- Escritorio: texto "MENÚ" / "CERRAR". "MENÚ" y "CERRAR"
             comparten la misma celda de grid (col-start-1 row-start-1)
             para cruzarse en fundido sin desplazar el resto del header;
             esa celda se dimensiona para la palabra más ancha
             ("CERRAR"). "place-items-center" centraba también en el
             eje horizontal, así que "MENÚ" (más corta) quedaba metida
             hacia la derecha, desalineada del resto del contenido del
             sitio — con "justify-items-start" solo se centra en
             vertical (items-center) y ambas palabras arrancan siempre
             en el mismo borde izquierdo. -->
        <span class="hidden md:grid md:items-center md:justify-items-start">
          <span class="hover-flip pointer-events-auto col-start-1 row-start-1 transition-opacity duration-200 group-open:pointer-events-none group-open:opacity-0">
            <span class="flip-a block">{t("a11y.menu")}</span>
            <span aria-hidden="true" class="flip-b block">{t("a11y.menu")}</span>
          </span>
          <span class="hover-flip pointer-events-none col-start-1 row-start-1 opacity-0 transition-opacity duration-200 group-open:pointer-events-auto group-open:opacity-100">
            <span class="flip-a block">{t("a11y.close")}</span>
            <span aria-hidden="true" class="flip-b block">{t("a11y.close")}</span>
          </span>
        </span>
      </summary>

      <div class="menu-panel flex min-h-dvh flex-col">
        <nav aria-label="Principal" class="container-tight flex w-full flex-1 flex-col justify-center pt-24 pb-10 md:pt-28">
          <ol class="menu-list flex flex-col gap-1">
            {
              primaryNav.map((item) => (
                <li>
                  <a href={item.href} class="hover-flip block py-1.5">
                    <span class="flip-a font-heading block text-4xl font-medium text-foreground sm:text-5xl lg:text-6xl">
                      {wordsOf(item.label).map(({ w, idx }, wi) => (
                        <>
                          {wi > 0 && " "}
                          {HAS_ACCENT.test(w) ? (
                            w
                          ) : (
                            <span class="word-reveal">
                              <span style={`--wi:${idx}`}>{w}</span>
                            </span>
                          )}
                        </>
                      ))}
                    </span>
                    <span aria-hidden="true" class="flip-b font-heading block text-4xl font-medium sm:text-5xl lg:text-6xl">
                      {item.label}
                    </span>
                  </a>
                </li>
              ))
            }

            <!-- Proyectos: con submenú de las 4 verticales -->
            <li>
              <details class="group/proj">
                <summary class="flex cursor-pointer list-none items-center gap-4 py-1.5 select-none [&::-webkit-details-marker]:hidden">
                  <span class="hover-flip inline-block">
                    <span class="flip-a font-heading block text-4xl font-medium text-foreground sm:text-5xl lg:text-6xl">
                      {wordsOf(projectsLabel).map(({ w, idx }, wi) => (
                        <>
                          {wi > 0 && " "}
                          {HAS_ACCENT.test(w) ? (
                            w
                          ) : (
                            <span class="word-reveal">
                              <span style={`--wi:${idx}`}>{w}</span>
                            </span>
                          )}
                        </>
                      ))}
                    </span>
                    <span aria-hidden="true" class="flip-b font-heading block text-4xl font-medium sm:text-5xl lg:text-6xl">
                      {projectsLabel}
                    </span>
                  </span>
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0 rotate-90 text-muted-foreground transition-transform group-open/proj:-rotate-90">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </summary>
                <ol class="mt-2 mb-3 flex flex-col gap-1 pl-6 sm:pl-8">
                  {
                    services.map((s) => (
                      <li>
                        <a href={s.href} class="hover-flip font-heading inline-block py-1 text-xl font-medium text-muted-foreground uppercase sm:text-2xl">
                          <span class="flip-a block">{s.label}</span>
                          <span aria-hidden="true" class="flip-b block text-foreground">{s.label}</span>
                        </a>
                      </li>
                    ))
                  }
                </ol>
              </details>
            </li>

            {
              secondaryNav.map((item) => (
                <li>
                  <a href={item.href} class="hover-flip block py-1.5">
                    <span class="flip-a font-heading block text-4xl font-medium text-foreground sm:text-5xl lg:text-6xl">
                      {wordsOf(item.label).map(({ w, idx }, wi) => (
                        <>
                          {wi > 0 && " "}
                          {HAS_ACCENT.test(w) ? (
                            w
                          ) : (
                            <span class="word-reveal">
                              <span style={`--wi:${idx}`}>{w}</span>
                            </span>
                          )}
                        </>
                      ))}
                    </span>
                    <span aria-hidden="true" class="flip-b font-heading block text-4xl font-medium sm:text-5xl lg:text-6xl">
                      {item.label}
                    </span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>

        <div class="menu-footer container-tight flex w-full flex-col items-start gap-3 pb-10">
          <span class="font-label text-xs uppercase tracking-widest text-muted-foreground">{t("footer.follow")}</span>
          <div class="flex flex-wrap gap-x-8 gap-y-2">
            <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="hover-flip font-heading text-lg font-medium text-foreground uppercase">
              <span class="flip-a block">Instagram</span>
              <span aria-hidden="true" class="flip-b block text-gold">Instagram</span>
            </a>
            <a href={SITE.facebookUrl} target="_blank" rel="noopener" class="hover-flip font-heading text-lg font-medium text-foreground uppercase">
              <span class="flip-a block">Facebook</span>
              <span aria-hidden="true" class="flip-b block text-gold">Facebook</span>
            </a>
            <a href={SITE.youtubeUrl} target="_blank" rel="noopener" class="hover-flip font-heading text-lg font-medium text-foreground uppercase">
              <span class="flip-a block">YouTube</span>
              <span aria-hidden="true" class="flip-b block text-gold">YouTube</span>
            </a>
          </div>
        </div>
      </div>
    </details>

    <!-- Centro: logo (insignia circular animada). Se desvanece al hacer
         scroll para no competir visualmente con el contenido. -->
    <a
      href={routePath(locale, "home")}
      class:list={["relative z-50 col-start-2 justify-self-center", logoRevealsOnScroll && "header-logo-reveal-on-scroll"]}
      aria-label={`${SITE.brand} — ${t("nav.home")}`}
    >
      <Logo class="size-14 md:size-20" />
    </a>

    <!-- Derecha: idioma + Contacto (en móvil, solo icono; texto completo desde sm:).
         Las pastillas ganan opacidad de fondo al hacer scroll, para no
         perderse sobre el contenido. -->
    <div class="relative z-50 flex min-w-0 items-center justify-self-end gap-2 md:gap-3">
      <LanguageSwitcher locale={locale} alternates={alternates} variant="dropdown" />
      <a
        href={waLink(waDefaultMessage(locale))}
        target="_blank"
        rel="noopener"
        aria-label={t("cta.whatsapp.long")}
        class="header-pill font-nav flex size-12 shrink-0 items-center justify-end rounded-sm uppercase leading-none text-white transition-colors md:h-12 md:w-auto"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="size-4.5 md:hidden">
          <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z" />
        </svg>
        <span class="hover-flip hidden text-sm font-medium tracking-[0.06em] md:inline-block">
          <span class="flip-a block">{t("nav.contact")}</span>
          <span aria-hidden="true" class="flip-b block">{t("nav.contact")}</span>
        </span>
      </a>
    </div>
  </div>
</header>
