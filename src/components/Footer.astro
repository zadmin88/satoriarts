---
import { SITE, SERVICES, servicePath, waLink, waDefaultMessage } from "@/config";
import type { Locale } from "@/config";
import { routePath } from "@/i18n/routes";
import { useT } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const year = new Date().getFullYear();

const explore = [
  { href: routePath(locale, "portfolio"), label: t("nav.portfolio") },
  { href: routePath(locale, "journal"), label: t("nav.journal") },
  { href: routePath(locale, "about"), label: t("nav.about") },
  { href: routePath(locale, "contact"), label: t("nav.contact") },
];
---

<footer class="border-t border-border bg-card/40">
  <div class="container-tight grid gap-10 py-14 md:grid-cols-4">
    <div class="flex flex-col gap-3 md:col-span-2">
      <p class="font-heading text-xl font-semibold text-foreground">
        Satori<span class="text-gold">Arts</span>
      </p>
      <p class="max-w-sm text-sm text-muted-foreground">{t("footer.tagline")}</p>
      <div class="mt-1 flex flex-wrap items-center gap-4 text-sm">
        <a
          href={waLink(waDefaultMessage(locale))}
          target="_blank"
          rel="noopener"
          class="font-semibold text-wa underline-offset-4 hover:underline"
        >
          WhatsApp: {SITE.phoneDisplay}
        </a>
        <a
          href={SITE.instagramUrl}
          target="_blank"
          rel="noopener me"
          class="text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
        >
          @{SITE.instagram}
        </a>
      </div>
      <a
        href={`mailto:${SITE.email}`}
        class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
      >
        {SITE.email}
      </a>
    </div>

    <nav aria-label={t("footer.services")} class="flex flex-col gap-2">
      <p class="font-heading text-sm font-semibold uppercase tracking-wide text-foreground">
        {t("footer.services")}
      </p>
      {
        SERVICES.map((s) => (
          <a
            href={servicePath(locale, s)}
            class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
          >
            {s.i18n[locale].menuLabel}
          </a>
        ))
      }
    </nav>

    <nav aria-label={t("footer.explore")} class="flex flex-col gap-2">
      <p class="font-heading text-sm font-semibold uppercase tracking-wide text-foreground">
        {t("footer.explore")}
      </p>
      {
        explore.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="border-t border-border">
    <div class="container-tight flex flex-col gap-3 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.brand}. {t("footer.rights")}</p>
      <nav aria-label={t("footer.legal")} class="flex gap-4">
        <a href={routePath(locale, "legalNotice")} class="underline-offset-4 hover:text-foreground hover:underline">{t("footer.legalNotice")}</a>
        <a href={routePath(locale, "privacy")} class="underline-offset-4 hover:text-foreground hover:underline">{t("footer.privacy")}</a>
      </nav>
    </div>
  </div>
</footer>
