---
import { SITE } from "@/config";
import type { Locale } from "@/config";
import { routePath } from "@/i18n/routes";
import { useT } from "@/i18n/ui";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const year = new Date().getFullYear();

// Etiquetas ya en mayúsculas (JS), no con "text-transform: uppercase"
// en CSS: aplicar "uppercase" en vivo a texto con acentos (Conócenos,
// Navegación, Créditos...) duplica visualmente la tilde en algunos
// navegadores — mismo bug ya corregido en el menú principal (Header.astro).
const nav = [
  { href: routePath(locale, "home"), label: t("nav.home").toLocaleUpperCase(locale) },
  { href: routePath(locale, "about"), label: t("nav.aboutMenu").toLocaleUpperCase(locale) },
  { href: routePath(locale, "portfolio"), label: t("nav.portfolio").toLocaleUpperCase(locale) },
  { href: routePath(locale, "journal"), label: t("nav.journal").toLocaleUpperCase(locale) },
];
const navLabel = t("footer.navLabel").toLocaleUpperCase(locale);
const followLabel = t("footer.follow").toLocaleUpperCase(locale);
const legalNotice = t("footer.legalNotice").toLocaleUpperCase(locale);
const privacy = t("footer.privacy").toLocaleUpperCase(locale);
const credits = t("footer.credits").toLocaleUpperCase(locale);
---

<!-- mt-* reserva "aire" consistente entre el final de cualquier página
     y el footer (fondo blanco): así el contenido oscuro anterior nunca
     queda pegado a ese cambio de fondo, en ninguna página del sitio,
     sin tener que tocar el padding-bottom de cada sección por separado. -->
<footer class="mt-16 bg-white text-black sm:mt-20 md:mt-28">
  <!-- pt-14 arriba (aire consistente tras el bloque de navegación/
       redes) pero pb-4 abajo, NO py-14 simétrico: el mismo padding
       arriba y abajo (y luego pb-8) seguía dejando un espacio en
       blanco de sobra debajo de la fila de copyright/legal, reportado
       repetidamente — el footer debe terminar prácticamente pegado a
       esa línea, sin aire simétrico con el de arriba. -->
  <div class="stagger-grid container-tight pt-14 pb-4">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <nav aria-label={t("footer.navLabel")} class="reveal flex flex-col gap-3">
        <p class="font-heading text-sm font-medium text-black">{navLabel}</p>
        {
          nav.map((link) => (
            <a href={link.href} class="hover-flip inline-block text-xs font-medium tracking-wide text-neutral-500 hover:text-black">
              <span class="flip-a block">{link.label}</span>
              <span aria-hidden="true" class="flip-b block">{link.label}</span>
            </a>
          ))
        }
      </nav>

      <nav aria-label={t("footer.follow")} class="reveal flex flex-col gap-3">
        <p class="font-heading text-sm font-medium text-black">{followLabel}</p>
        <a href={SITE.instagramUrl} target="_blank" rel="noopener" class="hover-flip inline-block text-xs font-medium uppercase tracking-wide text-neutral-500 hover:text-black">
          <span class="flip-a block">Instagram</span>
          <span aria-hidden="true" class="flip-b block">Instagram</span>
        </a>
        <a href={SITE.facebookUrl} target="_blank" rel="noopener" class="hover-flip inline-block text-xs font-medium uppercase tracking-wide text-neutral-500 hover:text-black">
          <span class="flip-a block">Facebook</span>
          <span aria-hidden="true" class="flip-b block">Facebook</span>
        </a>
        <a href={SITE.youtubeUrl} target="_blank" rel="noopener" class="hover-flip inline-block text-xs font-medium uppercase tracking-wide text-neutral-500 hover:text-black">
          <span class="flip-a block">YouTube</span>
          <span aria-hidden="true" class="flip-b block">YouTube</span>
        </a>
      </nav>

      <div class="reveal flex flex-col gap-3">
        <a href="#top" class="hover-flip inline-flex items-center gap-2 text-sm font-heading font-medium uppercase text-black">
          <span class="flip-a flex items-center gap-2">
            <span>{t("a11y.backToTop")}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-3.5 -rotate-90"><path d="M8 5v14l11-7z" /></svg>
          </span>
          <span aria-hidden="true" class="flip-b flex items-center gap-2">
            <span>{t("a11y.backToTop")}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-3.5 -rotate-90"><path d="M8 5v14l11-7z" /></svg>
          </span>
        </a>
      </div>
    </div>

    <div class="reveal mt-12 flex flex-col items-start gap-3 pt-6 text-xs uppercase tracking-wide sm:flex-row-reverse sm:items-center sm:justify-between">
      <div class="flex flex-col items-start gap-2 text-left sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-4 sm:gap-y-2">
        <a href={routePath(locale, "legalNotice")} class="hover-flip normal-case inline-block text-neutral-500 hover:text-black">
          <span class="flip-a block">{legalNotice}</span>
          <span aria-hidden="true" class="flip-b block">{legalNotice}</span>
        </a>
        <span aria-hidden="true" class="hidden text-neutral-300 sm:inline">·</span>
        <a href={routePath(locale, "privacy")} class="hover-flip normal-case inline-block text-neutral-500 hover:text-black">
          <span class="flip-a block">{privacy}</span>
          <span aria-hidden="true" class="flip-b block">{privacy}</span>
        </a>
        <span aria-hidden="true" class="hidden text-neutral-300 sm:inline">·</span>
        <span class="hover-flip normal-case inline-block text-neutral-500">
          <span class="flip-a block">{credits}: {t("legal.pending")}</span>
          <span aria-hidden="true" class="flip-b block text-black">{credits}: {t("legal.pending")}</span>
        </span>
      </div>
      <span class="text-neutral-500">© {year} {SITE.brand}</span>
    </div>
  </div>
</footer>
