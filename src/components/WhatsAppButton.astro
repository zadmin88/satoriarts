---
import { waLink } from "@/config";
import { cn } from "@/lib/utils";

interface Props {
  /** Mensaje ya prellenado (usa waServiceMessage / waDefaultMessage) */
  message: string;
  label?: string;
  size?: "lg" | "md";
  /** Variante visual: sólida o contorno */
  variant?: "solid" | "outline";
  class?: string;
}

const {
  message,
  label = "WhatsApp",
  size = "md",
  variant = "solid",
  class: className,
} = Astro.props;
---

<a
  href={waLink(message)}
  target="_blank"
  rel="noopener"
  class={cn(
    "btn focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring active:translate-y-px",
    variant === "solid" ? "bg-foreground text-background" : "border border-border bg-transparent text-foreground",
    className,
  )}
>
  <span class="hover-flip inline-block">
    <span class="flip-a block">{label}</span>
    <span aria-hidden="true" class="flip-b block">{label}</span>
  </span>
</a>
