---
import Photo from "@/components/Photo.astro";
import type { ImageMetadata } from "astro";

interface Item {
  image: ImageMetadata;
  alt: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;

// Retícula rota (broken grid) editorial: 6 columnas con spans y
// desplazamientos verticales alternos. Cero JavaScript.
const span = ["md:col-span-4", "md:col-span-2", "md:col-span-3", "md:col-span-3", "md:col-span-4", "md:col-span-2"];
const aspect = ["aspect-[3/2]", "aspect-[4/5]", "aspect-[4/5]", "aspect-[3/2]", "aspect-[16/10]", "aspect-[4/5]"];
const offset = ["", "md:mt-16", "", "md:mt-10", "", "md:mt-20"];
---

<div class="grid grid-cols-2 gap-3 md:grid-cols-6 md:gap-5">
  {
    items.map((it, i) => (
      <Photo
        image={it.image}
        alt={it.alt}
        aspect={aspect[i % 6]}
        class={`${span[i % 6]} ${offset[i % 6]} reveal`}
        sizes="(max-width: 768px) 50vw, 40vw"
      />
    ))
  }
</div>
