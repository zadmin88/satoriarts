---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import CtaSection from "@/components/CtaSection.astro";
import EditorialGallery from "@/components/EditorialGallery.astro";
import Marquee from "@/components/Marquee.astro";
import Photo from "@/components/Photo.astro";
import {
  SERVICES,
  CITIES,
  DISCIPLINE_LABEL,
  servicePath,
  waDefaultMessage,
} from "@/config";
import type { Locale } from "@/config";
import { routePath, routeAlternates } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { WHY, TESTIMONIALS, HOME_SEO } from "@/i18n/home";
import { servicePhotos, heroPhotos, photoAlt } from "@/lib/photos";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const seo = HOME_SEO[locale];
const why = WHY[locale];
const testimonials = TESTIMONIALS[locale];

// Título del hero con la última palabra en cursiva dorada (acento editorial)
const titleWords = t("hero.title").split(" ");
const lastWord = titleWords.pop() ?? "";
const firstPart = titleWords.join(" ");

const marquee = [
  ...SERVICES.map((s) => s.i18n[locale].title),
  DISCIPLINE_LABEL.photo[locale],
  DISCIPLINE_LABEL.film[locale],
];

const preview = [
  { image: servicePhotos("bodas")[0], alt: photoAlt(locale, SERVICES[0].i18n[locale].title, 0) },
  { image: servicePhotos("hoteles")[0], alt: photoAlt(locale, SERVICES[2].i18n[locale].title, 0) },
  { image: servicePhotos("paisaje")[0], alt: photoAlt(locale, SERVICES[3].i18n[locale].title, 0) },
  { image: servicePhotos("eventos")[1], alt: photoAlt(locale, SERVICES[1].i18n[locale].title, 1) },
  { image: servicePhotos("bodas")[2], alt: photoAlt(locale, SERVICES[0].i18n[locale].title, 2) },
  { image: servicePhotos("hoteles")[3], alt: photoAlt(locale, SERVICES[2].i18n[locale].title, 3) },
];
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  alternates={routeAlternates("home")}
>
  <!-- HERO cinematográfico a sangre completa -->
  <section class="relative flex h-[92vh] min-h-[560px] w-full items-end overflow-hidden">
    <Image
      src={heroPhotos[0]}
      alt={photoAlt(locale, "Satori Arts", 0)}
      widths={[640, 1000]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/55 to-background/25"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-background/70 via-transparent to-transparent"></div>

    <div class="container-tight relative z-10 pb-16 md:pb-24">
      <p class="eyebrow mb-6">{t("hero.eyebrow")}</p>
      <h1 class="max-w-4xl font-heading text-[3rem] font-medium leading-[0.92] tracking-[-0.01em] text-foreground sm:text-7xl md:text-8xl">
        {firstPart} <span class="italic font-semibold text-gold">{lastWord}</span>
      </h1>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-foreground/85">{t("hero.subtitle")}</p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <WhatsAppButton size="lg" message={waDefaultMessage(locale)} label={t("cta.book")} />
        <a
          href={routePath(locale, "portfolio")}
          class="group inline-flex items-center gap-2 text-base font-medium text-foreground underline-offset-8 hover:text-gold"
        >
          <span class="border-b border-foreground/30 pb-1 group-hover:border-gold">{t("nav.portfolio")}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-4 transition-transform group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Marquee items={marquee} />

  <!-- SERVICIOS: filas editoriales -->
  <section aria-labelledby="serv-titulo" class="container-tight py-24 md:py-32">
    <div class="mb-16 max-w-2xl">
      <p class="eyebrow mb-5">{t("section.services")}</p>
      <h2 id="serv-titulo" class="font-heading text-4xl font-medium leading-tight text-foreground sm:text-6xl">{t("section.services.sub")}</h2>
    </div>

    <div class="flex flex-col">
      {
        SERVICES.map((s, i) => (
          <a
            href={servicePath(locale, s)}
            class="reveal group grid items-center gap-6 border-t border-border py-10 md:grid-cols-12 md:gap-12 md:py-12 last:border-b"
          >
            <div class:list={["md:col-span-5", i % 2 === 1 && "md:order-2"]}>
              <Photo image={servicePhotos(s.key)[0]} alt={photoAlt(locale, s.i18n[locale].title, 0)} aspect="aspect-[16/10]" sizes="(max-width:768px) 100vw, 42vw" />
            </div>
            <div class:list={["md:col-span-7", i % 2 === 1 && "md:order-1"]}>
              <div class="flex items-baseline gap-4">
                <span class="font-heading text-2xl italic text-gold/70">{String(i + 1).padStart(2, "0")}</span>
                <h3 class="font-heading text-3xl font-medium text-foreground transition-colors group-hover:text-gold sm:text-5xl">{s.i18n[locale].title}</h3>
              </div>
              <div class="mt-4 ml-11 flex flex-wrap gap-2">
                {s.disciplines.map((d) => (
                  <span class="font-label rounded-full border border-border px-3 py-0.5 text-[0.7rem] uppercase tracking-wider text-muted-foreground">{DISCIPLINE_LABEL[d][locale]}</span>
                ))}
              </div>
              <p class="mt-5 ml-11 max-w-md text-muted-foreground">{s.i18n[locale].short}</p>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- PORTFOLIO PREVIEW -->
  <section aria-labelledby="pf-titulo" class="border-t border-border bg-card/30">
    <div class="container-tight py-24 md:py-32">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-4">
        <h2 id="pf-titulo" class="font-heading text-4xl font-medium text-foreground sm:text-6xl">{t("nav.portfolio")}</h2>
        <a href={routePath(locale, "portfolio")} class="font-label text-sm uppercase tracking-wider text-gold-deep underline-offset-4 hover:text-gold hover:underline">{t("cta.seeMore")}</a>
      </div>
      <EditorialGallery items={preview} />
    </div>
  </section>

  <!-- POR QUÉ -->
  <section aria-labelledby="why-titulo" class="container-tight py-24 md:py-32">
    <p class="eyebrow mb-14">{t("section.why")}</p>
    <div class="grid gap-x-12 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
      {
        why.map((p, i) => (
          <div class="reveal flex flex-col gap-3">
            <span class="font-heading text-2xl italic text-gold/70">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="font-heading text-xl font-medium text-foreground">{p.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section aria-labelledby="test-titulo" class="border-y border-border bg-card/30">
    <div class="container-tight py-24 md:py-32">
      <h2 id="test-titulo" class="mb-16 max-w-2xl font-heading text-3xl font-medium leading-tight text-foreground sm:text-5xl">{t("section.testimonials")}</h2>
      <div class="grid gap-10 md:grid-cols-3">
        {
          testimonials.map((tm) => (
            <figure class="reveal flex flex-col gap-6">
              <blockquote class="font-heading text-2xl italic leading-snug text-foreground/90">“{tm.quote}”</blockquote>
              <figcaption class="mt-auto">
                <span class="block font-medium text-foreground">{tm.author}</span>
                <span class="font-label text-xs uppercase tracking-wider text-muted-foreground">{tm.context}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CIUDADES -->
  <section aria-labelledby="cities-titulo" class="container-tight py-20">
    <p class="eyebrow mb-6">{t("section.cities")}</p>
    <div class="flex flex-wrap items-baseline gap-x-8 gap-y-2">
      {CITIES.map((c) => (
        <span class="font-heading text-4xl italic text-foreground sm:text-6xl">{c.name}</span>
      ))}
      <span class="font-label text-sm uppercase tracking-wider text-muted-foreground">+ destinos</span>
    </div>
  </section>

  <CtaSection locale={locale} message={waDefaultMessage(locale)} />
</BaseLayout>
