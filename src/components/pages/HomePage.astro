---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import CtaSection from "@/components/CtaSection.astro";
import Logo from "@/components/Logo.astro";
import { SITE, SERVICES, CLIENTS, waDefaultMessage } from "@/config";
import type { Locale } from "@/config";
import { routePath, routeAlternates } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { TESTIMONIALS, HOME_SEO } from "@/i18n/home";
import { servicePhotos, heroPhotos, photoAlt } from "@/lib/photos";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const seo = HOME_SEO[locale];
const testimonials = TESTIMONIALS[locale];

const preview = [
  { image: servicePhotos("bodas")[0], alt: photoAlt(locale, SERVICES[0].i18n[locale].title, 0) },
  { image: servicePhotos("hoteles")[0], alt: photoAlt(locale, SERVICES[2].i18n[locale].title, 0) },
  { image: servicePhotos("paisaje")[0], alt: photoAlt(locale, SERVICES[3].i18n[locale].title, 0) },
  { image: servicePhotos("eventos")[1], alt: photoAlt(locale, SERVICES[1].i18n[locale].title, 1) },
  { image: servicePhotos("bodas")[2], alt: photoAlt(locale, SERVICES[0].i18n[locale].title, 2) },
  { image: servicePhotos("hoteles")[3], alt: photoAlt(locale, SERVICES[2].i18n[locale].title, 3) },
];
---

<BaseLayout
  locale={locale}
  title={seo.title}
  description={seo.description}
  alternates={routeAlternates("home")}
  logoRevealsOnScroll
>
  <!-- HERO cinematográfico a sangre completa: sube por encima del padding
       del <main> para que el header (con su fondo de cristal permanente)
       quede justo sobre el vídeo, sin hueco. Solo la marca (logo + lema)
       vive aquí, centrada a pantalla completa —igual que el "VERO" del
       referente—; el titular y el CTA tienen su propia sección justo
       debajo. -->
  <section class="relative -mt-24 flex h-[92svh] min-h-[560px] w-full flex-col items-center justify-center overflow-hidden bg-background px-5 text-center sm:px-6 md:-mt-28 md:h-[92dvh]">
    <div data-parallax="0.1" class="absolute inset-0">
      <video
        src="/video_hero.mp4"
        poster={heroPhotos[0].src}
        preload="metadata"
        autoplay
        muted
        loop
        playsinline
        aria-hidden="true"
        class="ken-burns h-full w-full object-cover"
      ></video>
    </div>
    <!-- Degradado con solo el canal alpha (sin color-mix, que en Safari/
         WebView móviles sin soporte cae a un fallback que lo vuelve
         sólido opaco casi hasta el 90% de la sección — justo el bloque
         negro grande que se veía). Opaco solo en una franja mínima
         (0–3%) pegada al borde inferior, para que la costura con la
         siguiente sección siga siendo invisible; a partir de ahí el
         oscurecimiento máximo es 65%, no negro puro, y se desvanece de
         forma gradual y continua hasta transparente. -->
    <!-- Viñeta simple de 2 puntos, sin capas intermedias: negro al 85%
         (nunca 100% opaco) en el borde inferior, transparente ya al 55%
         de la altura — la mitad superior de la imagen queda nítida sin
         ningún oscurecimiento, y la transición entre ambos puntos es
         una única rampa lineal continua (sin escalones ni "cortes"). La
         costura con la sección siguiente no depende de que esto llegue
         a opacidad total: esa sección ya se solapa 1px con el mismo
         fondo (ver "-mt-px" más abajo), así que aquí no hace falta. -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 to-transparent to-55%"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-background/70 via-transparent to-transparent"></div>

    <!-- Marca centrada, como el "VERO" del referente -->
    <div class="relative z-10 flex flex-col items-center">
      <a href={routePath(locale, "home")} aria-label={`${SITE.brand} — ${t("nav.home")}`} class="hero-fade-up">
        <Logo class="size-56 sm:size-64 md:size-80" />
      </a>
    </div>
  </section>

  <!-- TEXTO GRANDE: solo el lema "Fotografía y vídeo...", como la pantalla
       de texto que sigue al hero en verostudio.com — sin CTA ni párrafo
       aquí, para que la transición sea limpia. El "-mt-px" (1px) hace que
       esta sección se superponga ligerísimamente sobre el hero: en
       algunos móviles, la altura real del viewport (barra de
       direcciones dinámica) deja un resto de subpíxel entre "92svh" y el
       alto visible real, que sin este solape se ve como una línea justo
       en el límite. Al superponerse con el mismo fondo (bg-background
       en ambas), un solape de 1px es invisible pase lo que pase. -->
  <section class="section-space container-tight relative -mt-px flex flex-col items-start justify-center bg-background text-left sm:items-center sm:text-center">
    <h1 class="font-heading font-medium leading-[1.15] text-foreground">
      {
        t("hero.brandTagline")
          .split("\n")
          .map((line) => (
            <span data-reveal-words class="block text-6xl sm:text-8xl md:text-9xl lg:text-[10rem]">
              {line}
            </span>
          ))
      }
    </h1>
  </section>

  <!-- MANIFIESTO: declaración de criterio + CTA, en su propia sección -->
  <section aria-labelledby="manifesto-titulo" class="section-space container-prose text-left sm:text-center">
    <h2 id="manifesto-titulo" data-reveal-words class="font-heading text-3xl font-medium text-balance text-foreground sm:text-5xl">
      {t("section.manifesto.title")}
    </h2>
    <p class="reveal mt-3 text-lg leading-relaxed text-muted-foreground">{t("section.manifesto.text")}</p>
    <div class="reveal mt-6 flex flex-wrap items-center justify-start gap-4 sm:justify-center">
      <WhatsAppButton size="lg" message={waDefaultMessage(locale)} label={t("cta.book")} />
    </div>
  </section>

  <!-- PROYECTOS: vista previa en masonry de 2 columnas EXPLÍCITAS
       (reparto por índice, no CSS "columns-*"), misma técnica que
       /proyectos/ (PortfolioPage.astro): cada foto conserva su
       proporción natural (sin aspect-ratio fijo ni object-cover que la
       recorte) y cada columna fluye de forma independiente, así fotos
       de distinta orientación (vertical/horizontal) no dejan huecos
       entre sí — a diferencia de un grid por filas con aspect-ratio
       uniforme, donde la foto más alta de la fila dejaba un hueco bajo
       las más bajas. -->
  <section aria-labelledby="pf-titulo">
    <div class="section-space container-tight">
      <!-- items-baseline: alinea "PROYECTOS" y el CTA por su línea base
           real de texto — lo pedido explícitamente. El problema técnico
           real (ya diagnosticado y ahora resuelto de raíz, no con
           ajustes a ojo): ".hover-flip" tiene "overflow: hidden"
           (necesario para el efecto de recorte del texto al pasar el
           cursor). Por especificación CSS, un elemento con overflow
           distinto de "visible" NO expone su línea base real a un
           ancestro flex — en su lugar aporta el borde INFERIOR de su
           caja como "línea base" sintética. Ningún ajuste de
           line-height (ni "leading-none", ni "normal") puede arreglar
           esto: el problema no es el interlineado, es que el propio
           overflow:hidden invalida la línea base para efectos de
           flexbox, por diseño del estándar CSS.
           Solución real: un texto "fantasma" invisible (visibility:
           hidden, NUNCA display:none — así sigue ocupando espacio y
           participa en el cálculo de items-baseline) con el MISMO
           texto, MISMA fuente/tamaño, pero SIN overflow:hidden. Ese
           fantasma es el que de verdad se usa para alinear (su línea
           base es la real). El enlace ".hover-flip" (con la animación
           de recorte intacta) se superpone exactamente encima con
           "absolute inset-0", así el usuario ve y usa el de siempre,
           pero el que cuenta para la alineación es el invisible. -->
      <!-- Sin "data-reveal-words" en este título: ese atributo dispara
           splitIntoView() en scroll-reveal.ts, que REESCRIBE por JS el
           contenido del <h2> envolviendo cada palabra en un
           "<span style='display:inline-block; overflow:hidden'>" para
           el efecto de entrada palabra a palabra. Ese "overflow:hidden"
           inyectado corrompe la línea base REAL del propio título (la
           misma regla CSS de "overflow≠visible sintetiza la línea
           base" que ya se corrigió del lado del CTA) — así que aunque
           el CTA estuviera perfectamente resuelto, el título mismo
           quedaba con una línea base falsa en cuanto el script de
           reveal terminaba de correr, reintroduciendo el desajuste. El
           bloque entero sigue animándose en conjunto vía ".reveal" (en
           el div padre); solo se pierde el efecto palabra a palabra
           específico de "PROYECTOS", mismo tipo de compromiso ya
           aceptado en otros títulos con este problema (ver
           ProjectsGallery.astro). -->
      <div class="reveal mb-6 flex flex-wrap items-baseline justify-between gap-4">
        <h2 id="pf-titulo" class="font-heading text-3xl font-normal uppercase text-foreground sm:text-5xl">{t("nav.portfolio")}</h2>
        <span class="relative inline-block font-label text-sm font-medium uppercase tracking-wider">
          <!-- Fantasma: mismo texto, mismo tipo/tamaño, visibility:hidden
               (ocupa espacio y define la línea base real del span
               padre) — nunca "display:none" (eso lo sacaría del
               flujo y items-baseline no tendría de dónde tomar la
               línea base). TAMPOCO "display:block": un hijo de nivel
               bloque hace que el span contenedor deje de tener línea
               de texto PROPIA (line box) — por especificación, en ese
               caso su línea base también se sintetiza como el borde
               inferior de la caja, el mismo problema que se quería
               evitar. Debe quedarse "inline" (el valor por defecto de
               un span), así el contenedor sí forma una línea de texto
               real con una línea base real. -->
          <span aria-hidden="true" class="invisible">{t("cta.seeMore")}</span>
          <a href={routePath(locale, "portfolio")} class="hover-flip absolute inset-0 text-white">
            <span class="flip-a block">{t("cta.seeMore")}</span>
            <span aria-hidden="true" class="flip-b block">{t("cta.seeMore")}</span>
          </a>
        </span>
      </div>
      <div class="grid grid-cols-2 gap-x-3 sm:gap-x-4">
        {
          [preview.filter((_, i) => i % 2 === 0), preview.filter((_, i) => i % 2 === 1)].map((col) => (
            <div class="flex flex-col gap-3 sm:gap-4">
              {col.map((p) => (
                <Image
                  src={p.image}
                  alt={p.alt}
                  widths={[320, 480, 768]}
                  sizes="50vw"
                  loading="lazy"
                  class="reveal-img h-auto w-full"
                />
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CLIENTES: tarjetas blancas horizontales, como el carrusel de
       clientes de videinfra.com. [PENDIENTE]: cuando haya nombres y
       descripciones reales, volver a envolver cada tarjeta en <details>
       con nombre + icono "+" al pie, que despliega la descripción del
       cliente (sin JS) — mientras tanto se muestra solo el logo. -->
  <section aria-labelledby="clientes-titulo" class="reveal bg-background">
    <div class="section-space container-tight">
      <p id="clientes-titulo" data-reveal-words class="mb-6 font-heading text-3xl font-normal uppercase text-foreground sm:text-5xl">{t("section.clients")}</p>
      <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
        {
          CLIENTS.map((c) => (
            <div class="flex aspect-[4/3] items-center justify-center">
              <Logo class="size-20 opacity-80" spin={false} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TESTIMONIOS: carrusel de tarjetas sobre fondo negro, con una
       barra de progreso delgada (JS mínimo, ver testimonial-carousel.ts,
       con fallback de arrastre/scroll nativo si algo falla). -->
  <section aria-labelledby="test-titulo" data-carousel class="bg-background">
    <div class="section-space container-tight">
      <!-- items-baseline + texto fantasma: mismo problema y misma
           solución que "PROYECTOS"/"VER LOS PROYECTOS" del home (ver
           esa sección para la explicación completa) — ".hover-flip"
           usa overflow:hidden, que por especificación CSS invalida su
           línea base real para efectos de flexbox (aporta el borde
           inferior de su caja en su lugar). El texto fantasma
           (visibility:hidden, sin overflow:hidden) es el que de verdad
           define la línea base ante "items-baseline"; el enlace real
           (con el icono y la animación de recorte) se superpone
           encima. "absolute inset-y-0 left-0" (no "inset-0"): deja que
           el enlace conserve su ancho natural (texto + icono), ya que
           el fantasma no incluye el icono — solo necesita coincidir en
           la parte superior/inferior y el punto de arranque
           izquierdo. -->
      <div class="reveal mb-6 flex flex-wrap items-baseline justify-between gap-4">
        <!-- Sin "data-reveal-words": mismo motivo que "PROYECTOS" más
             arriba (el reveal palabra a palabra inyecta overflow:hidden
             por JS, corrompiendo la línea base real del título frente
             a "items-baseline" con el CTA de reseñas de Google). -->
        <h2 id="test-titulo" class="font-heading text-3xl font-normal uppercase leading-tight text-foreground sm:text-5xl">{t("section.testimonials")}</h2>
        <span class="relative inline-block font-label text-sm font-medium uppercase tracking-wider text-muted-foreground">
          <span aria-hidden="true" class="invisible block">{SITE.googleRating.toFixed(1)} · {SITE.googleReviewCount} {t("cta.googleReviews")}</span>
          <a href={SITE.googleReviewsUrl} target="_blank" rel="noopener" class="hover-flip absolute inset-y-0 left-0 inline-flex items-center gap-2">
            <span class="flip-a flex items-center gap-2">
              <span>{SITE.googleRating.toFixed(1)} · {SITE.googleReviewCount} {t("cta.googleReviews")}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-2.5 shrink-0"><path d="M8 5v14l11-7z" /></svg>
            </span>
            <span aria-hidden="true" class="flip-b flex items-center gap-2">
              <span>{SITE.googleRating.toFixed(1)} · {SITE.googleReviewCount} {t("cta.googleReviews")}</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-2.5 shrink-0"><path d="M8 5v14l11-7z" /></svg>
            </span>
          </a>
        </span>
      </div>
      <div data-carousel-track class="carousel-track -mx-5 flex snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-2 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0">
        {
          testimonials.map((tm) => (
            <figure class="reveal flex w-[82%] shrink-0 snap-center flex-col gap-6 bg-card p-8 sm:w-[46%] lg:w-[38%]">
              <blockquote class="font-heading text-lg leading-snug text-foreground/90">“{tm.quote}”</blockquote>
              <figcaption>
                <span class="block text-sm font-medium text-foreground">{tm.author}</span>
                <span class="font-label text-xs uppercase tracking-wider text-muted-foreground">{tm.context}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="mt-6 h-px w-full overflow-hidden bg-border">
        <div data-carousel-progress class="h-full w-1/4 bg-foreground transition-transform duration-300 ease-out"></div>
      </div>
    </div>
  </section>

  <script>
    import "@/scripts/testimonial-carousel";
  </script>

  <CtaSection locale={locale} message={waDefaultMessage(locale)} />
</BaseLayout>
