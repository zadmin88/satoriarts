---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { Locale } from "@/config";
import { routeAlternates, journalArticlePath } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { servicePhotos, photoAlt } from "@/lib/photos";
import { JOURNAL_ENABLED, JOURNAL_POSTS } from "@/i18n/journal-content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const SEO: Record<Locale, { title: string; description: string; h1: string; lead: string }> = {
  es: {
    title: "Journal · Bodas, venues e ideas · Satori Arts",
    description: "El journal de Satori Arts: reportajes de bodas, guías de venues en Barcelona y Madrid e ideas para tu día.",
    h1: "Journal",
    lead: "Mucho más que una galería: aquí quedan las bodas y los espacios de hostelería que hemos tenido el privilegio de capturar.",
  },
  en: {
    title: "Journal · Weddings, venues and ideas · Satori Arts",
    description: "The Satori Arts journal: wedding and event stories, venue guides in Barcelona and Madrid, and ideas for your day.",
    h1: "Journal",
    lead: "Real stories, venue guides and tips. Here we publish the weddings we shoot and the best estates and hotels we work in.",
  },
  ca: {
    title: "Journal · Casaments, venues i idees · Satori Arts",
    description: "El journal de Satori Arts: reportatges de casaments, guies de venues a Barcelona i Madrid i idees per al teu dia.",
    h1: "Journal",
    lead: "Reportatges reals, guies d'espais i consells. Aquí publiquem els casaments que fem i les millors masies i hotels on disparem.",
  },
};
const seo = SEO[locale];

// Artículos del Journal (src/i18n/journal-content.ts). Mientras
// JOURNAL_ENABLED sea false, las tarjetas se muestran solo como foto en gris
// con "Próximamente" encima, sin enlace ni texto.
const posts = JOURNAL_POSTS[locale];
---

<BaseLayout locale={locale} title={seo.title} description={seo.description} alternates={routeAlternates("journal")}>
  <section class="section-space container-tight">
    <h1 data-reveal-words class="font-heading text-3xl font-normal uppercase text-foreground sm:text-5xl">{seo.h1}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{seo.lead}</p>
  </section>

  <section class="container-tight pb-24">
    <div class="stagger-grid grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-3">
      {
        posts.map((d) => {
          const photo = (
            <div class="relative aspect-[16/9] overflow-hidden bg-card">
              <Image
                src={servicePhotos(d.cover.service)[d.cover.index]}
                alt={JOURNAL_ENABLED ? photoAlt(locale, d.title, d.cover.index) : ""}
                widths={[480, 768]}
                sizes="(max-width: 640px) 100vw, 33vw"
                loading="eager"
                class={JOURNAL_ENABLED ? "h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" : "h-full w-full object-cover grayscale"}
              />
              {!JOURNAL_ENABLED && (
                <div class="absolute inset-0 flex items-center justify-center bg-black/55">
                  <span class="font-label text-sm font-medium tracking-[0.2em] text-white uppercase">{t("journal.comingSoon")}</span>
                </div>
              )}
            </div>
          );
          return JOURNAL_ENABLED ? (
            <a href={journalArticlePath(locale, d.slug)} class="reveal group block text-left">
              {photo}
              <span class="font-heading mt-5 block text-lg font-medium text-foreground">{d.title}</span>
              <p class="font-label mt-2 text-sm font-medium text-foreground uppercase">{d.category}</p>
              <p class="font-label text-xs text-muted-foreground uppercase">{d.date}</p>
            </a>
          ) : (
            <div class="reveal">{photo}</div>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
