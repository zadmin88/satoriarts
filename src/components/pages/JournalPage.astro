---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import type { Locale } from "@/config";
import { routeAlternates } from "@/i18n/routes";
import { servicePhotos } from "@/lib/photos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const SEO: Record<Locale, { title: string; description: string; h1: string; lead: string }> = {
  es: {
    title: "Journal · Bodas, venues e ideas · Satori Arts",
    description: "El journal de Satori Arts: reportajes de bodas y eventos, guías de venues en Barcelona y Madrid e ideas para tu día.",
    h1: "Journal",
    lead: "Mucho más que una galería: aquí quedan las bodas, los eventos y los espacios de hostelería que hemos tenido el privilegio de capturar.",
  },
  en: {
    title: "Journal · Weddings, venues and ideas · Satori Arts",
    description: "The Satori Arts journal: wedding and event stories, venue guides in Barcelona and Madrid, and ideas for your day.",
    h1: "Journal",
    lead: "Real stories, venue guides and tips. Here we publish the weddings and events we shoot and the best estates and hotels we work in.",
  },
  ca: {
    title: "Journal · Casaments, venues i idees · Satori Arts",
    description: "El journal de Satori Arts: reportatges de casaments i esdeveniments, guies de venues a Barcelona i Madrid i idees per al teu dia.",
    h1: "Journal",
    lead: "Reportatges reals, guies d'espais i consells. Aquí publiquem els casaments i esdeveniments que fem i les millors masies i hotels on disparem.",
  },
};
const seo = SEO[locale];

// [PLACEHOLDER] Cuando haya artículos reales, sustituir por una content
// collection. Fecha y texto son de ejemplo, como el journal de
// makemepulse.com/news.
const drafts: Record<Locale, { title: string; date: string; tag: string; image: ImageMetadata }[]> = {
  es: [
    { title: "Boda en el Empordà", date: "12 sept 2026", tag: "Bodas", image: servicePhotos("bodas")[1] },
    { title: "Dentro de un hotel boutique en Barcelona", date: "28 ago 2026", tag: "Hoteles, Proceso", image: servicePhotos("hoteles")[1] },
    { title: "Guía de fincas para bodas en Madrid", date: "3 jul 2026", tag: "Bodas, Venues", image: servicePhotos("bodas")[5] },
  ],
  en: [
    { title: "A wedding in the Empordà", date: "12 Sep 2026", tag: "Weddings", image: servicePhotos("bodas")[1] },
    { title: "Inside a boutique hotel in Barcelona", date: "28 Aug 2026", tag: "Hotels, Process", image: servicePhotos("hoteles")[1] },
    { title: "A guide to wedding venues in Madrid", date: "3 Jul 2026", tag: "Weddings, Venues", image: servicePhotos("bodas")[5] },
  ],
  ca: [
    { title: "Un casament a l'Empordà", date: "12 set 2026", tag: "Casaments", image: servicePhotos("bodas")[1] },
    { title: "Dins d'un hotel boutique a Barcelona", date: "28 ago 2026", tag: "Hotels, Procés", image: servicePhotos("hoteles")[1] },
    { title: "Guia de masies per a casaments a Madrid", date: "3 jul 2026", tag: "Casaments, Venues", image: servicePhotos("bodas")[5] },
  ],
};
const posts = drafts[locale];
---

<BaseLayout locale={locale} title={seo.title} description={seo.description} alternates={routeAlternates("journal")}>
  <section class="container-tight py-16 md:py-20">
    <h1 data-reveal-words class="font-heading text-3xl font-normal uppercase text-foreground sm:text-5xl">{seo.h1}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">{seo.lead}</p>
  </section>

  <!-- Tarjetas con imagen: foto arriba y título debajo, en tres
       columnas, como el journal de referencia. -->
  <section class="container-tight pb-24">
    <div class="stagger-grid grid grid-cols-1 gap-x-8 gap-y-14 sm:grid-cols-3">
      {
        posts.map((d) => (
          <article class="reveal group block">
            <div class="aspect-[16/9] overflow-hidden bg-card">
              <Image
                src={d.image}
                alt={d.title}
                widths={[480, 768]}
                sizes="(max-width: 640px) 100vw, 33vw"
                loading="eager"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            </div>
            <span class="font-heading mt-5 block text-lg font-medium text-foreground">{d.title}</span>
            <p class="font-label mt-2 text-sm font-medium text-foreground">{d.tag}</p>
            <p class="font-label text-xs text-muted-foreground">{d.date}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
