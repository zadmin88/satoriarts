---
import ServiceLayout from "@/layouts/ServiceLayout.astro";
import { getService } from "@/config";
import type { Locale, ServiceKey } from "@/config";
import { SERVICE_CONTENT } from "@/i18n/services-content";

interface Props {
  locale: Locale;
  serviceKey: ServiceKey;
}

const { locale, serviceKey } = Astro.props;
const service = getService(serviceKey);
const c = SERVICE_CONTENT[serviceKey][locale];
---

<ServiceLayout
  locale={locale}
  service={service}
  seoTitle={c.seoTitle}
  seoDescription={c.seoDescription}
  h1={c.h1}
  heroIntro={c.heroIntro}
  bodyHtml={c.bodyHtml}
  faqs={c.faqs}
/>
