---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { SITE, CITIES, getService, servicePath, waServiceMessage } from "@/config";
import type { Locale, ServiceKey } from "@/config";
import { useT } from "@/i18n/ui";
import { servicePhotos, photoAlt } from "@/lib/photos";
import { cityServiceCopy, cityServicePath, cityServiceAlternates } from "@/i18n/city-service";

interface Props {
  locale: Locale;
  serviceKey: ServiceKey;
  citySlug: string;
}
const { locale, serviceKey, citySlug } = Astro.props;
const t = useT(locale);
const service = getService(serviceKey);
const city = CITIES.find((c) => c.slug === citySlug)!;
const copy = cityServiceCopy(locale, service, city);
const galleryItems = servicePhotos(serviceKey).map((image, i) => ({ image, alt: photoAlt(locale, service.i18n[locale].title, i) }));
const pageUrl = new URL(cityServicePath(locale, serviceKey, city), SITE.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: `${service.i18n[locale].title} · ${city.name}`,
    description: copy.description,
    url: pageUrl,
    serviceType: service.i18n[locale].title,
    areaServed: { "@type": "City", name: city.name },
    provider: { "@type": "ProfessionalService", name: SITE.brand, url: SITE.url },
  },
];
---

<BaseLayout
  locale={locale}
  title={copy.title}
  description={copy.description}
  alternates={cityServiceAlternates(serviceKey, city)}
  jsonLd={jsonLd}
>
  <header class="bg-card/40">
    <div class="container-tight py-14 md:py-20">
      <p class="eyebrow mb-3">{city.name} · {service.i18n[locale].title}</p>
      <h1 class="max-w-3xl font-heading text-4xl font-medium text-foreground sm:text-5xl md:text-6xl">{copy.h1}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">{copy.intro}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <WhatsAppButton size="lg" message={waServiceMessage(locale, service)} label={t("cta.book")} />
        <a href={servicePath(locale, service)} class="hover-flip text-sm font-semibold text-foreground underline underline-offset-4">
          <span class="flip-a block">{service.i18n[locale].title} →</span>
          <span aria-hidden="true" class="flip-b block">{service.i18n[locale].title} →</span>
        </a>
      </div>
    </div>
  </header>

  <div class="reveal prose-body container-prose py-14" set:html={copy.bodyHtml}></div>

  <section class="container-tight pb-14">
    <div class="mb-10 border-b border-border" />
    <div class="grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2">
      {
        galleryItems.map((item) => (
          <div class="group relative block">
            <Image
              src={item.image}
              alt={item.alt}
              widths={[480, 768, 1024]}
              sizes="(max-width: 640px) 100vw, 50vw"
              loading="eager"
              class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
            <div class="mt-4">
              <span class="font-heading text-lg font-medium text-foreground">{service.i18n[locale].title}</span>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
