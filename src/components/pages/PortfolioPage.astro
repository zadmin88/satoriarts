---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import ProjectsGallery, { type ServiceBlock } from "@/components/ProjectsGallery.astro";
import type { GridItem } from "@/components/GridMediaItem.astro";
import { SERVICES, servicePath, waDefaultMessage } from "@/config";
import type { Locale } from "@/config";
import { routeAlternates } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { servicePhotos, photoAlt } from "@/lib/photos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

const SEO: Record<Locale, { title: string; description: string; intro: string }> = {
  es: {
    title: "Proyectos · Fotografía y Film · Satori Arts",
    description: "Proyectos de Satori Arts: bodas, eventos, hoteles y paisaje en foto y vídeo. Barcelona, Madrid y destino.",
    intro: "Una selección de nuestro trabajo. Bodas, eventos, hoteles y paisaje, en foto y en film.",
  },
  en: {
    title: "Projects · Photography & Film · Satori Arts",
    description: "Satori Arts projects: weddings, events, hotels and landscape in photo and film. Barcelona, Madrid and destination.",
    intro: "A selection of our work. Weddings, events, hotels and landscape, in photo and film.",
  },
  ca: {
    title: "Projectes · Fotografia i Film · Satori Arts",
    description: "Projectes de Satori Arts: casaments, esdeveniments, hotels i paisatge en foto i vídeo. Barcelona, Madrid i destí.",
    intro: "Una selecció de la nostra feina. Casaments, esdeveniments, hotels i paisatge, en foto i film.",
  },
};
const seo = SEO[locale];

// Cuadrícula de cada servicio: solo fotos (sin vídeo, quitado a
// propósito de las secciones internas de Proyectos), repartidas en 2
// columnas EXPLÍCITAS (no CSS "columns-2"): con "columns-*", el
// navegador decide en qué columna cae cada elemento según un algoritmo
// de equilibrio de alturas totales, no en el orden "1→col A, 2→col B"
// — por eso ni siquiera la primera fila garantizaba arrancar a la
// misma altura. Repartiendo nosotros mismos las fotos (alternando por
// índice), la primera foto de cada columna siempre arranca en el
// mismo punto superior — sin recortar ni forzar el tamaño de ninguna,
// cada fila siguiente se sigue escalonando de forma natural según el
// alto real de lo anterior en su propia columna. Todo sigue siendo
// filtrable por servicio con radio + :has() (cero JavaScript): cada
// foto lleva su propio "data-service", y también el contenedor que las
// envuelve.
const serviceBlocks: ServiceBlock[] = SERVICES.map((s) => {
  const copy = s.i18n[locale];
  const photos: GridItem[] = servicePhotos(s.key).map((image, i) => ({
    type: "photo" as const,
    image,
    alt: photoAlt(locale, copy.title, i),
    key: s.key,
    href: servicePath(locale, s),
    title: copy.title,
  }));
  const photoColumns: [GridItem[], GridItem[]] = [[], []];
  photos.forEach((p, i) => photoColumns[i % 2].push(p));
  return { key: s.key, photos, photoColumns };
});
---

<BaseLayout locale={locale} title={seo.title} description={seo.description} alternates={routeAlternates("portfolio")}>
  <!-- ProjectsGallery: MISMO componente que usa cada página de
       servicio (vía ServiceLayout.astro) — cualquier cambio de
       spacing/sticky/grid se hace una sola vez ahí y se refleja en las
       5 categorías. Solo las pestañas (radio+label aquí, filtrado 100%
       CSS con :has() para no recargar página) llegan por el slot
       "filters" — es la única pieza que de verdad no se puede unificar
       (ver ProjectsGallery.astro para la explicación completa). -->
  <ProjectsGallery locale={locale} blocks={serviceBlocks} withGridId>
    <Fragment slot="filters">
      <input type="radio" name="pf-filter" id="pf-all" class="sr-only" checked />
      <label for="pf-all" class="btn filter-pill shrink-0">
        <span class="hover-flip">
          <span class="flip-a block">{t("portfolio.filterAll")}</span>
          <span aria-hidden="true" class="flip-b block">{t("portfolio.filterAll")}</span>
        </span>
      </label>
      {
        SERVICES.map((s) => (
          <>
            <input type="radio" name="pf-filter" id={`pf-filter-${s.key}`} class="sr-only" />
            <label for={`pf-filter-${s.key}`} class="btn filter-pill shrink-0">
              <span class="hover-flip">
                <span class="flip-a block">{s.i18n[locale].title}</span>
                <span aria-hidden="true" class="flip-b block">{s.i18n[locale].title}</span>
              </span>
            </label>
          </>
        ))
      }
    </Fragment>
  </ProjectsGallery>

  <!-- Alineada SIEMPRE a la izquierda (no centrada en desktop, a
       diferencia del mismo patrón de CTA en otras páginas): el título,
       la barra de categorías y el grid de arriba son todos left-
       aligned contra el mismo margen de "container-tight" — centrar
       esta sección en desktop la hacía "arrancar" en un punto
       horizontal distinto al resto de "Proyectos", dando la sensación
       de bloques descuadrados entre sí dentro de la misma página. -->
  <section class="section-space reveal container-tight flex flex-col items-start gap-8 text-left sm:gap-6">
    <p class="text-balance font-heading text-4xl font-medium text-foreground sm:text-3xl">{t("cta.dateQuestion")}</p>
    <WhatsAppButton size="lg" message={waDefaultMessage(locale)} label={t("cta.book")} />
  </section>

  <script>
    import "@/scripts/filter-scroll";
  </script>
</BaseLayout>
