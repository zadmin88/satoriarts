---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/Photo.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { SITE, waDefaultMessage } from "@/config";
import type { Locale } from "@/config";
import { routeAlternates } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { teamPhotos } from "@/lib/photos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

interface Member {
  tagline: string;
  bio: string;
}
interface Pillar {
  title: string;
  text: string;
}
const CONTENT: Record<
  Locale,
  {
    title: string;
    description: string;
    h1: string;
    lead: string;
    detail: string;
    members: Member[];
    together: string;
    process: string;
    pillars: Pillar[];
    talkTitle: string;
    talkText: string;
  }
> = {
  es: {
    title: "Conócenos · El dúo detrás de Satori Arts",
    description: "Manuel y Stephanie, fotógrafos y realizadores de vídeo con más de 10 años de experiencia en bodas y marcas de hostelería en Barcelona y Madrid.",
    h1: "Satori Arts nació hace diez años de una misma pasión: contar historias con fotografía y cine.",
    lead: "Buscamos no guardar un momento, sino conservar cómo se sintió.",
    detail: "Esa sensibilidad, esa dirección de arte, esa observación, es lo que convierte cada imagen en algo elegante, auténtico, atemporal y, sobre todo, que hace sentir.",
    members: [
      { tagline: "El ojo detrás de la cámara.", bio: "Manuel dirige la fotografía de cada proyecto, con una mirada que persigue el instante exacto, antes de que vuelva a ser pose. Su capacidad para leer la luz y el gesto en el momento justo es lo que da a cada imagen su carácter." },
      { tagline: "", bio: "Soy Stephanie Reyes, fotógrafa y filmmaker, especializada en crear imágenes que cuentan historias y transmiten emociones.\n\nEstudié Producción Audiovisual y me especialicé en Estilismo y Dirección de Arte en Barcelona, una formación que me enseñó a mirar más allá de la imagen y a prestar atención a todo aquello que hace especial una escena: la luz, los espacios, las texturas, los detalles y, sobre todo, las emociones.\n\nMe apasiona especialmente el mundo de las bodas. Vivo cada una como si fuera la mía: me implico, cuido cada detalle y pongo toda mi energía en conseguir que cada celebración sea única y especial. Me emociona capturar esas miradas que duran un segundo, las manos, las risas, la decoración, la luz entrando por una ventana… todos esos pequeños instantes que, juntos, cuentan una historia.\n\nTambién encuentro una enorme inspiración en los hoteles de lujo y los espacios singulares. Me encanta descubrir su esencia y traducirla en imágenes: sus arquitecturas, sus atmósferas, sus luces, sus texturas y esos detalles que hacen que cada lugar tenga una personalidad propia.\n\nY, por supuesto, los eventos. Me apasiona observar todo lo que sucede delante y detrás de una celebración y encontrar la belleza de la gran puesta en escena hasta el pequeño detalle que quizá nadie más ha visto.\n\nMi manera de trabajar nace de una mezcla de sensibilidad, dirección de arte y observación. Busco imágenes elegantes, auténticas y atemporales, pero sobre todo imágenes que hagan sentir.\n\nPorque para mí, fotografiar no es simplemente guardar un momento.\n\nEs conservar cómo se sintió." },
    ],
    together: "Manuel y Stephanie comparten, desde hace más de una década, un criterio que es el pilar sobre el que se levanta cada proyecto de Satori Arts. Gracias a esa mirada conjunta, logramos imágenes y vídeos que combinan verdad y elegancia con una edición atemporal.",
    process: "Cada encargo está pensado para que nuestros clientes no solo tengan un recuerdo, sino que lo sientan como una extensión de ese instante vivido. Además, la cercanía ocupa un lugar central en nuestra filosofía: acompañamos cada proyecto desde la primera conversación hasta la entrega final, asegurando que cada imagen sea tanto un recuerdo como un legado.",
    pillars: [
      { title: "Un mismo equipo", text: "Sin intermediarios: las mismas dos personas de principio a fin." },
      { title: "Agilidad", text: "Entregas rápidas, sin comprometer el resultado." },
      { title: "Trato cercano", text: "Comunicación directa con nosotros en cada etapa." },
      { title: "Edición con carácter", text: "Un estilo propio, reconocible en cada plano." },
    ],
    talkTitle: "¿Hablamos?",
    talkText: "Lo hacemos de manera cercana y flexible.",
  },
  en: {
    title: "About · The duo behind Satori Arts",
    description: "Manuel and Stephanie, photographer and filmmaker with over 10 years of experience in weddings and hospitality brands in Barcelona and Madrid.",
    h1: "Satori Arts was born ten years ago from a shared passion: telling stories through photography and film.",
    lead: "We aim not to keep a moment, but to preserve how it felt.",
    detail: "That sensitivity, that art direction, that observation, is what turns every image into something elegant, authentic, timeless and, above all, something that makes you feel.",
    members: [{ tagline: "", bio: "" }, { tagline: "", bio: "I'm Stephanie Reyes, a photographer and filmmaker who specialises in creating images that tell stories and convey emotion.\n\nI studied Audiovisual Production and specialised in Styling and Art Direction in Barcelona, training that taught me to look beyond the image and to notice everything that makes a scene special: the light, the spaces, the textures, the details and, above all, the emotions.\n\nI am especially passionate about weddings. I live each one as if it were my own: I get involved, I look after every detail and I put all my energy into making every celebration unique and special. I love capturing those glances that last a second, the hands, the laughter, the decoration, the light coming in through a window… all those small moments that, together, tell a story.\n\nI also find huge inspiration in luxury hotels and unique spaces. I love discovering their essence and translating it into images: their architecture, their atmospheres, their light, their textures and those details that give each place its own personality.\n\nAnd, of course, events. I love watching everything that happens in front of and behind a celebration, and finding the beauty from the grand staging down to the small detail that perhaps no one else has seen.\n\nMy way of working comes from a mix of sensitivity, art direction and observation. I look for elegant, authentic and timeless images, but above all images that make you feel.\n\nBecause for me, photographing is not simply keeping a moment.\n\nIt is preserving how it felt." }],
    together: "Together they've built a shared eye over more than a decade, so the photo and film of every project tell a single story.",
    process: "From the first conversation to the final delivery, we work with couples getting married and hospitality brands that need content for their website and social media.",
    pillars: [
      { title: "One same team", text: "No middlemen: the same two people from start to finish." },
      { title: "Speed", text: "Fast delivery, without compromising the result." },
      { title: "Close relationship", text: "Direct communication with us at every stage." },
      { title: "Editing with character", text: "A recognisable style in every frame." },
    ],
    talkTitle: "Shall we talk?",
    talkText: "We keep it close and flexible.",
  },
  ca: {
    title: "Coneix-nos · El duo darrere de Satori Arts",
    description: "Manuel i Stephanie, fotògraf i realitzadora de vídeo amb més de 10 anys d'experiència en casaments i marques d'hostaleria a Barcelona i Madrid.",
    h1: "Satori Arts va néixer fa deu anys d'una mateixa passió: explicar històries amb fotografia i cinema.",
    lead: "Busquem no guardar un moment, sinó conservar com es va sentir.",
    detail: "Aquesta sensibilitat, aquesta direcció d'art, aquesta observació, és el que converteix cada imatge en alguna cosa elegant, autèntica, atemporal i, sobretot, que fa sentir.",
    members: [{ tagline: "", bio: "" }, { tagline: "", bio: "Sóc la Stephanie Reyes, fotògrafa i filmmaker, especialitzada a crear imatges que expliquen històries i transmeten emocions.\n\nVaig estudiar Producció Audiovisual i em vaig especialitzar en Estilisme i Direcció d'Art a Barcelona, una formació que em va ensenyar a mirar més enllà de la imatge i a fixar-me en tot allò que fa especial una escena: la llum, els espais, les textures, els detalls i, sobretot, les emocions.\n\nM'apassiona especialment el món dels casaments. Visc cadascun com si fos el meu: m'hi implico, cuido cada detall i hi poso tota la meva energia perquè cada celebració sigui única i especial. M'emociona capturar aquestes mirades que duren un segon, les mans, les rialles, la decoració, la llum entrant per una finestra… tots aquests petits instants que, junts, expliquen una història.\n\nTambé trobo una enorme inspiració en els hotels de luxe i els espais singulars. M'encanta descobrir-ne l'essència i traduir-la en imatges: les seves arquitectures, els seus ambients, les seves llums, les seves textures i aquells detalls que fan que cada lloc tingui personalitat pròpia.\n\nI, és clar, els esdeveniments. M'apassiona observar tot el que passa davant i darrere d'una celebració i trobar la bellesa, des de la gran posada en escena fins al petit detall que potser ningú més ha vist.\n\nLa meva manera de treballar neix d'una barreja de sensibilitat, direcció d'art i observació. Busco imatges elegants, autèntiques i atemporals, però sobretot imatges que facin sentir.\n\nPerquè per a mi, fotografiar no és simplement guardar un moment.\n\nÉs conservar com es va sentir." }],
    together: "Junts han construït un criteri compartit durant més d'una dècada, perquè la fotografia i el vídeo de cada projecte expliquin una sola història.",
    process: "Des de la primera conversa fins al lliurament final, acompanyem parelles que es casen i marques d'hostaleria que necessiten contingut per a la seva web i xarxes.",
    pillars: [
      { title: "Un mateix equip", text: "Sense intermediaris: les mateixes dues persones de principi a fi." },
      { title: "Agilitat", text: "Lliuraments ràpids, sense comprometre el resultat." },
      { title: "Tracte proper", text: "Comunicació directa amb nosaltres a cada etapa." },
      { title: "Edició amb caràcter", text: "Un estil propi, reconeixible a cada pla." },
    ],
    talkTitle: "Parlem?",
    talkText: "Ho fem de manera propera i flexible.",
  },
};
const c = CONTENT[locale];

// Retratos reales del dúo (src/assets/photos/team/01-manuel-fotografo.jpg = Manuel,
// 02-stephanie-video.jpg = Stephanie, mismo orden que SITE.team). En pantalla se
// muestran en orden inverso (Stephanie primero), así que se recorre por
// índice en vez de reordenar el array fuente.
const memberPhotos = teamPhotos;
const teamOrder = [1, 0];

---

<BaseLayout locale={locale} title={c.title} description={c.description} alternates={routeAlternates("about")}>
  <section class="section-space container-prose text-left sm:text-center">
    <h1 class="reveal-scale font-heading text-3xl leading-tight font-medium text-balance text-foreground sm:mx-auto sm:max-w-3xl sm:text-5xl md:text-6xl">{c.h1}</h1>
    <p class="reveal mt-6 max-w-2xl font-heading text-xl leading-snug font-medium text-foreground/90 sm:mx-auto sm:text-2xl">{c.lead}</p>
    <p class="reveal mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:mx-auto">{c.detail}</p>
  </section>

  <!-- EQUIPO: Stephanie y Manu, apilados y alineados a la izquierda en
       móvil; desde sm:, en fila de dos columnas. -->
  <section class="section-space">
    <div class="container-tight">
      <div class="flex flex-col gap-12 text-left sm:grid sm:grid-cols-2 sm:gap-12">
        {
          teamOrder.map((i) => {
            const member = SITE.team[i];
            return (
              <div class="reveal flex flex-col gap-6">
                <Photo image={memberPhotos[i]} alt={member.name} aspect="aspect-[3/4]" sizes="(max-width:640px) 100vw, 50vw" grayscale />
                <div>
                  <h2 class="sr-only">{member.name}</h2>
                  {c.members[i]?.tagline && <p class="font-heading text-xl font-medium text-foreground/90">{c.members[i].tagline}</p>}
                  {
                    c.members[i]?.bio && (() => {
                      // Si la bio tiene varios párrafos, el primero (presentación)
                      // va al tamaño de la frase destacada; el resto, como texto normal.
                      const [first, ...rest] = c.members[i].bio.split("\n\n");
                      const intro = rest.length > 0;
                      return (
                        <div class="mt-4 flex max-w-md flex-col gap-4 text-muted-foreground">
                          {intro ? <p class="font-heading text-xl font-medium text-foreground/90">{first}</p> : <p>{first}</p>}
                          {rest.map((p) => <p>{p}</p>)}
                        </div>
                      );
                    })()
                  }
                  <a
                    href={`https://www.instagram.com/${member.instagram}/`}
                    target="_blank"
                    rel="noopener"
                    class="hover-flip font-label mt-4 inline-block text-sm text-muted-foreground underline underline-offset-4"
                  >
                    <span class="flip-a block">@{member.instagram}</span>
                    <span aria-hidden="true" class="flip-b block">@{member.instagram}</span>
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- DECLARACIÓN: los dos párrafos que unen el criterio del dúo -->
  <section class="bg-card/30">
    <div class="section-space container-prose flex flex-col gap-6 text-left sm:text-center">
      <p class="reveal font-heading text-2xl font-medium text-balance text-foreground sm:text-3xl">{c.together}</p>
      <p class="reveal max-w-xl text-lg leading-relaxed text-muted-foreground sm:mx-auto">{c.process}</p>
    </div>
  </section>

  <section class="section-space reveal container-tight flex flex-col items-start gap-8 text-left sm:items-center sm:gap-6 sm:text-center">
    <p class="text-balance font-heading text-4xl font-medium text-foreground sm:text-3xl">{t("cta.talkQuestion")}</p>
    <WhatsAppButton size="lg" message={waDefaultMessage(locale)} label={t("cta.writeUs")} />
  </section>
</BaseLayout>
