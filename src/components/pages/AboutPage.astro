---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Photo from "@/components/Photo.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { SITE, waDefaultMessage } from "@/config";
import type { Locale } from "@/config";
import { routeAlternates } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { teamPhotos } from "@/lib/photos";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);

interface Member {
  tagline: string;
  bio: string;
}
interface Pillar {
  title: string;
  text: string;
}
const CONTENT: Record<
  Locale,
  {
    title: string;
    description: string;
    h1: string;
    lead: string;
    detail: string;
    members: Member[];
    together: string;
    process: string;
    pillars: Pillar[];
    talkTitle: string;
    talkText: string;
  }
> = {
  es: {
    title: "Conócenos · El dúo detrás de Satori Arts",
    description: "Manuel y Stephanie, fotógrafos y realizadores de vídeo con más de 10 años de experiencia en bodas y marcas de hostelería en Barcelona y Madrid.",
    h1: "Satori Arts nació hace diez años de una pasión: contar historias con fotografía y cine.",
    lead: "Buscamos no guardar un momento, sino conservar su emoción. Stephanie y Manuel lo logran con sensibilidad, dirección de arte y observación. Esa combinación convierte cada imagen en algo elegante, auténtico, atemporal y sobre todo que hace sentir.",
    detail: "",
    members: [
      { tagline: "", bio: "Soy Manuel Franco, fotógrafo y director de fotografía.\n\nEmpecé con el paisaje, y ahí aprendí lo más importante del oficio: la luz cambia sin avisar y la montaña no posa. Hoy dirijo la parte creativa de Satori Arts: fotografía, cámara de vídeo y edición.\n\nHago lo mismo en una boda, en un hotel o en un restaurante: dejo que la gente olvide la cámara y solo entonces disparo.\n\nEl paisaje me enseñó a esperar. Lo sigo haciendo." },
      { tagline: "", bio: "Soy Stephanie Reyes, fotógrafa y filmmaker.\n\nEstudié Producción Audiovisual y me especialicé en Estilismo y Dirección de Arte en Barcelona, una formación que me enseñó a mirar más allá de la imagen y a prestar atención a todo aquello que hace especial un momento: la luz, las texturas, los detalles. Desde entonces, esa mirada me lleva a tres lugares distintos.\n\nEn una boda busco las manos que se encuentran, las risas que se escapan, el sol que se cuela por una ventana. En un hotel o un restaurante, la personalidad de cada espacio, cada rincón, cada acabado. Y en un evento, tanto lo grande como el gesto pequeño que pasa desapercibido.\n\nEl escenario cambia. La mirada, no." },
    ],
    together: "Manuel y Stephanie comparten, desde hace más de una década, un criterio que es el pilar sobre el que se levanta cada proyecto de Satori Arts. Gracias a esa mirada conjunta, logramos imágenes y vídeos que combinan verdad y elegancia con una edición atemporal.",
    process: "Cada encargo está pensado para que nuestros clientes no solo tengan un recuerdo, sino que lo sientan como una extensión de ese instante vivido. Además, la cercanía ocupa un lugar central en nuestra filosofía: acompañamos cada proyecto desde la primera conversación hasta la entrega final, asegurando que cada imagen sea tanto un recuerdo como un legado.",
    pillars: [
      { title: "Un mismo equipo", text: "Sin intermediarios: las mismas dos personas de principio a fin." },
      { title: "Agilidad", text: "Entregas rápidas, sin comprometer el resultado." },
      { title: "Trato cercano", text: "Comunicación directa con nosotros en cada etapa." },
      { title: "Edición con carácter", text: "Un estilo propio, reconocible en cada plano." },
    ],
    talkTitle: "¿Hablamos?",
    talkText: "Lo hacemos de manera cercana y flexible.",
  },
  en: {
    title: "About · The duo behind Satori Arts",
    description: "Manuel and Stephanie, photographer and filmmaker with over 10 years of experience in weddings and hospitality brands in Barcelona and Madrid.",
    h1: "Satori Arts was born ten years ago from a passion: telling stories through photography and film.",
    lead: "We aim not to keep a moment, but to preserve its emotion. Stephanie and Manuel achieve it with sensitivity, art direction and observation. That combination turns every image into something elegant, authentic, timeless and, above all, something that makes you feel.",
    detail: "",
    members: [{ tagline: "", bio: "" }, { tagline: "", bio: "I'm Stephanie Reyes, a photographer and filmmaker.\n\nI studied Audiovisual Production and specialised in Styling and Art Direction in Barcelona, training that taught me to look beyond the image and to notice everything that makes a scene special: the light, the spaces, the textures and the details. Since then, that way of looking has taken me to four different places.\n\nAt a wedding I look for hands reaching for each other, laughter slipping out, sunlight coming through a window nobody planned. In a hotel or a restaurant I look for the personality of each piece of architecture, each corner, each finish. And at an event I look for both the grand staging and the small gesture almost no one notices.\n\nThe setting changes. The way of looking does not." }],
    together: "Together they've built a shared eye over more than a decade, so the photo and film of every project tell a single story.",
    process: "From the first conversation to the final delivery, we work with couples getting married and hospitality brands that need content for their website and social media.",
    pillars: [
      { title: "One same team", text: "No middlemen: the same two people from start to finish." },
      { title: "Speed", text: "Fast delivery, without compromising the result." },
      { title: "Close relationship", text: "Direct communication with us at every stage." },
      { title: "Editing with character", text: "A recognisable style in every frame." },
    ],
    talkTitle: "Shall we talk?",
    talkText: "We keep it close and flexible.",
  },
  ca: {
    title: "Coneix-nos · El duo darrere de Satori Arts",
    description: "Manuel i Stephanie, fotògraf i realitzadora de vídeo amb més de 10 anys d'experiència en casaments i marques d'hostaleria a Barcelona i Madrid.",
    h1: "Satori Arts va néixer fa deu anys d'una passió: explicar històries amb fotografia i cinema.",
    lead: "Busquem no guardar un moment, sinó conservar-ne l'emoció. La Stephanie i el Manuel ho aconsegueixen amb sensibilitat, direcció d'art i observació. Aquesta combinació converteix cada imatge en alguna cosa elegant, autèntica, atemporal i, sobretot, que fa sentir.",
    detail: "",
    members: [{ tagline: "", bio: "" }, { tagline: "", bio: "Sóc la Stephanie Reyes, fotògrafa i filmmaker.\n\nVaig estudiar Producció Audiovisual i em vaig especialitzar en Estilisme i Direcció d'Art a Barcelona, una formació que em va ensenyar a mirar més enllà de la imatge i a fixar-me en tot allò que fa especial una escena: la llum, els espais, les textures i els detalls. Des de llavors, aquesta mirada em porta a quatre llocs diferents.\n\nEn un casament busco les mans que es busquen, les rialles que s'escapen, el sol entrant per una finestra que ningú no va planejar. En un hotel o un restaurant busco la personalitat que té cada arquitectura, cada racó, cada acabat. I en un esdeveniment busco tant la gran posada en escena com el gest petit que gairebé ningú no nota.\n\nL'escenari canvia. La mirada, no." }],
    together: "Junts han construït un criteri compartit durant més d'una dècada, perquè la fotografia i el vídeo de cada projecte expliquin una sola història.",
    process: "Des de la primera conversa fins al lliurament final, acompanyem parelles que es casen i marques d'hostaleria que necessiten contingut per a la seva web i xarxes.",
    pillars: [
      { title: "Un mateix equip", text: "Sense intermediaris: les mateixes dues persones de principi a fi." },
      { title: "Agilitat", text: "Lliuraments ràpids, sense comprometre el resultat." },
      { title: "Tracte proper", text: "Comunicació directa amb nosaltres a cada etapa." },
      { title: "Edició amb caràcter", text: "Un estil propi, reconeixible a cada pla." },
    ],
    talkTitle: "Parlem?",
    talkText: "Ho fem de manera propera i flexible.",
  },
};
const c = CONTENT[locale];

// Retratos reales del dúo (src/assets/photos/team/01-manuel-fotografo.jpg = Manuel,
// 02-stephanie-video.jpg = Stephanie, mismo orden que SITE.team). En pantalla se
// muestran en orden inverso (Stephanie primero), así que se recorre por
// índice en vez de reordenar el array fuente.
const memberPhotos = teamPhotos;
const teamOrder = [1, 0];

---

<BaseLayout locale={locale} title={c.title} description={c.description} alternates={routeAlternates("about")}>
  <section class="section-space container-prose text-left sm:text-center">
    <h1 class="reveal-scale font-heading text-3xl leading-tight font-medium text-balance text-foreground sm:mx-auto sm:max-w-3xl sm:text-5xl">{c.h1}</h1>
    <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-muted-foreground sm:mx-auto sm:text-lg">{c.lead}</p>
  </section>

  <!-- EQUIPO: Stephanie y Manu, apilados y alineados a la izquierda en
       móvil; desde sm:, en fila de dos columnas. -->
  <section class="section-space">
    <div class="container-tight">
      <div class="flex flex-col gap-12 text-left sm:grid sm:grid-cols-2 sm:gap-12">
        {
          teamOrder.map((i) => {
            const member = SITE.team[i];
            return (
              <div class="reveal flex flex-col gap-6">
                <Photo image={memberPhotos[i]} alt={member.name} aspect="aspect-[3/4]" sizes="(max-width:640px) 100vw, 50vw" grayscale />
                <div>
                  <h2 class="sr-only">{member.name}</h2>
                  {c.members[i]?.tagline && <p class="font-heading text-xl font-medium text-foreground/90">{c.members[i].tagline}</p>}
                  {
                    c.members[i]?.bio && (() => {
                      // Si la bio tiene varios párrafos, el primero (presentación)
                      // va al tamaño de la frase destacada; el resto, como texto normal.
                      const [first, ...rest] = c.members[i].bio.split("\n\n");
                      const intro = rest.length > 0;
                      return (
                        <div class="mt-4 flex max-w-md flex-col gap-4 text-muted-foreground">
                          {intro ? <p class="font-heading text-xl font-medium text-foreground/90">{first}</p> : <p>{first}</p>}
                          {rest.map((p) => <p>{p}</p>)}
                        </div>
                      );
                    })()
                  }
                  <a
                    href={`https://www.instagram.com/${member.instagram}/`}
                    target="_blank"
                    rel="noopener"
                    class="hover-flip font-label mt-4 inline-block text-sm text-muted-foreground underline underline-offset-4"
                  >
                    <span class="flip-a block">@{member.instagram}</span>
                    <span aria-hidden="true" class="flip-b block">@{member.instagram}</span>
                  </a>
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section-space reveal container-tight flex flex-col items-start gap-8 text-left sm:items-center sm:gap-6 sm:text-center">
    <p class="text-balance font-heading text-4xl font-medium text-foreground sm:text-3xl">{t("cta.talkQuestion")}</p>
    <WhatsAppButton size="lg" message={waDefaultMessage(locale)} label={t("cta.writeUs")} />
  </section>
</BaseLayout>
