---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WhatsAppButton from "@/components/WhatsAppButton.astro";
import { Image } from "astro:assets";
import type { Locale } from "@/config";
import { waDefaultMessage } from "@/config";
import { journalArticlePath, journalArticleAlternates } from "@/i18n/routes";
import { useT } from "@/i18n/ui";
import { getJournalPost, relatedJournalPosts, type JournalPost } from "@/i18n/journal-content";
import { servicePhotos, photoAlt } from "@/lib/photos";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useT(locale);
const post = getJournalPost(locale, slug) as JournalPost;

const related = relatedJournalPosts(locale, post.groupId, 3);

// Formato editorial minimalista (fondo blanco, columna angosta): tras
// el titular, una galería en carrusel horizontal (hasta 6 fotos del
// mismo servicio, cada una con su proporción original) y un único
// párrafo de texto corrido — no la lista de bloques intercalados de
// antes. Todas las fotos del servicio se unen aquí como texto seguido
// (sin las etiquetas <p>/<em> de los bloques) para formar ese párrafo
// único. [Nota] El sitio no tiene un peso de fuente "light/thin" real
// autoalojado (solo 400/500/600/700) — el titular usa 400, el más
// liviano disponible, igual que el resto de títulos del sitio.
const galleryPhotos = servicePhotos(post.cover.service)
  .slice(0, 6)
  .map((image, i) => ({ image, alt: photoAlt(locale, post.title, i) }));

const bodyText = post.blocks
  .filter((b) => b.type === "text" || b.type === "quote")
  .map((b) => (b.type === "quote" ? b.text : b.html.replace(/<[^>]+>/g, "")))
  .join(" ");
---

<BaseLayout
  locale={locale}
  title={`${post.title} · Journal · Satori Arts`}
  description={post.excerpt}
  alternates={journalArticleAlternates(post.groupId)}
>
  <!-- -mb-16 sm:-mb-20 md:-mb-28 SOLO cuando no hay carrusel de
       relacionados después (related.length === 0): en ese caso este es
       el último bloque antes del Footer, y necesita cancelar el mismo
       margin-top del Footer que expondría el fondo oscuro del <body>
       entre dos bloques blancos — ver el comentario junto al carrusel
       más abajo para la explicación completa. Cuando sí hay carrusel,
       esta clase no se aplica aquí porque el carrusel es el que queda
       justo antes del Footer. -->
  <div class:list={["journal-article bg-white text-neutral-600", related.length === 0 && "-mb-16 sm:-mb-20 md:-mb-28"]}>
    <!-- HEADER: sin foto de cabecera — titular alineado a la izquierda
         en mobile (como el resto de textos del sitio en ese
         breakpoint) y centrado desde desktop, en varias líneas si hace
         falta, peso 400 (el más ligero autoalojado en el sitio). -->
    <header class="container-prose pt-16 text-left sm:text-center md:pt-24">
      <h1 data-reveal-words class="font-heading text-4xl leading-tight font-normal text-neutral-900 sm:text-5xl">{post.title}</h1>
      <!-- Fecha de publicación: antes del artículo (junto al título),
           no al final. Hereda el mismo "text-left sm:text-center" del
           <header>. -->
      <p class="font-label mt-4 text-xs text-neutral-400 uppercase">{post.date}</p>
    </header>

    <!-- GALERÍA: carrusel de scroll horizontal (no masonry) — cada foto
         conserva su proporción y orientación original (altura fija,
         ancho automático, sin aspect-ratio forzado ni object-cover que
         recorte).
         [Fix] Antes usaba "bleed+repad" (sangrado -mx en el elemento
         que scrollea + padding en un hijo interior) — esa técnica sirve
         para que el CONTENIDO llegue al borde de la pantalla (el caso
         de la barra de filtros de Proyectos), pero aquí el efecto
         era el contrario al deseado: a mitad de scroll, las fotos
         quedaban pegadas al borde real de la pantalla sin ningún
         margen, en mobile y en desktop, porque el elemento con scroll
         no tenía padding propio en ningún punto intermedio (el padding
         de "container-tight" solo se nota en el reposo inicial/final,
         nunca mientras se está desplazando). Ahora el límite lo pone
         "container-tight overflow-hidden" por FUERA: la galería queda
         siempre dentro del margen del sitio, en cualquier posición de
         scroll, porque el recorte (overflow-hidden) ocurre justo en el
         borde con padding, no en el borde real de la pantalla. -->
    <!-- "relative" en el wrapper exterior: las flechas se posicionan
         sobre la galería sin salirse del recorte ("overflow-hidden")
         del contenedor con padding. -->
    <div class="container-tight reveal relative mt-10 overflow-hidden md:mt-14">
      <!-- data-drag-scroll: el scroll táctil/trackpad ya funcionaba,
           pero con ratón (sin rueda horizontal) no hay forma nativa de
           arrastrar — drag-scroll.ts añade arrastre con click sostenido
           también para ratón normal en desktop. -->
      <!-- max-w-[85vw] en cada foto, solo mobile ("sm:max-w-none" lo
           quita en desktop): con solo una altura fija, una foto ancha
           puede acabar ocupando casi todo el viewport, sin dejar
           asomar ni un borde de la siguiente — así no se nota que hay
           más fotos y scroll horizontal. Limitando el ancho máximo de
           cada una, siempre queda al menos un margen visible de la
           próxima foto como pista de que se puede seguir deslizando. -->
      <div data-drag-scroll class="no-scrollbar flex cursor-grab items-end gap-4 overflow-x-auto pb-2 active:cursor-grabbing snap-x snap-mandatory scroll-smooth sm:gap-6">
        {
          galleryPhotos.map(({ image, alt }) => (
            <Image
              src={image}
              alt={alt}
              height={384}
              loading="eager"
              class="h-64 max-w-[85vw] w-auto shrink-0 snap-start object-contain sm:h-96 sm:max-w-none"
            />
          ))
        }
      </div>
      <!-- Degradado en el borde derecho, SOLO desktop (hidden sm:block):
           en mobile ya hay arrastre táctil nativo + el "peek" del
           borde como pista de que hay más fotos; en desktop, sin
           gesto táctil ni rueda horizontal, no era evidente que la
           galería siguiera más allá de lo visible. No interactivo
           (pointer-events-none, no tapa clics ni arrastre) — solo
           sugiere visualmente que el contenido continúa, fundiendo a
           blanco (el fondo real de esta sección) en vez de un botón
           que compita con las fotos. -->
      <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 hidden w-16 bg-gradient-to-l from-white to-transparent sm:block"></div>
    </div>

    <!-- CUERPO: "container-tight" (no "container-prose-left") en el
         propio journal-body para que la fecha de más abajo (absolute,
         left-5/left-6) siga anclada al margen izquierdo real del
         sitio — iaunque el párrafo y el CTA ahora vivan en su propio
         bloque interior, centrado en pantalla desde desktop
         ("sm:mx-auto", max-w-3xl): antes, al estar el párrafo/CTA
         dentro de un "container-prose-left" (sin mx-auto, anclado a la
         izquierda a propósito para otros casos), el texto solo se
         centraba DENTRO de esa columna ya pegada a la izquierda —
         nunca llegaba a verse centrado en la pantalla completa. -->
    <div class="journal-body container-tight relative pt-14 pb-24 md:pb-28">
      <div class="max-w-3xl sm:mx-auto">
        <p class="reveal text-left text-sm leading-relaxed sm:text-center sm:text-base">{bodyText}</p>

        <!-- CTA final: mismo botón de WhatsApp (WhatsAppButton) que en
             el resto del sitio, no un link de texto aparte —
             consistencia con Home/Proyectos/Nosotros/Contacto.
             Alineado a la izquierda en mobile, centrado en pantalla en
             desktop, igual que el párrafo de arriba. -->
        <div class="reveal mt-10 flex justify-start sm:justify-center">
          <WhatsAppButton size="lg" message={waDefaultMessage(locale)} label={t("cta.talkQuestion")} class="bg-neutral-900 text-white" />
        </div>
      </div>
    </div>
  </div>

  <!-- ARTÍCULOS SIMILARES: mismo formato de tarjeta compacta que la
       cuadrícula del Journal (imagen + título + categoría + fecha,
       todo dentro de la misma tarjeta), pero en un carrusel horizontal
       en vez de un grid fijo — mismo patrón data-carousel que el
       carrusel de testimonios de la home (arrastre/scroll táctil +
       barra de progreso), sin la clase ".carousel-track" (ese efecto
       de opacidad/escala es propio de las citas grandes, no encaja con
       tarjetas de imagen pequeñas).
       Fondo NEGRO a propósito (bg-background, el tema oscuro por
       defecto del sitio — "--foreground" es el token CLARO/blanco de
       texto y "--background" el OSCURO/negro de fondo, al revés de lo
       que parecen sugerir sus nombres a primera vista) — a diferencia
       de arriba (el artículo en sí, blanco), aquí no hace falta
       cancelar el margin-top del Footer: esa cancelación (-mb-*) solo
       era necesaria cuando una sección BLANCA precedía al Footer
       (también blanco) y dejaba ver el fondo oscuro del <body> en el
       hueco. Con esta sección ya oscura, el margin-top del Footer
       vuelve a cumplir su propósito original (separar contenido
       oscuro del footer blanco), así que no lleva ningún margen
       negativo. -->
  <!-- section-space: mismo padding arriba y abajo (antes "pb-24" fijo
       abajo vs "pt-10/16/20" responsive arriba — un resto del patrón
       de Proyectos, donde ese "pb-24" reservaba espacio extra antes
       del footer; aquí no hace falta, el Footer ya trae su propio
       margen). Con la misma medida en los dos lados, el bloque de
       título + tarjetas queda centrado dentro de la franja negra, no
       corrido hacia arriba. -->
  <!-- -mb-16 sm:-mb-20 md:-mb-28: cancela el margin-top que el Footer
       añade antes de sí mismo (pensado para separar contenido OSCURO
       del footer blanco). Esta sección ya es oscura — sin cancelarlo,
       ese margen (invisible como "hueco" porque es del mismo negro que
       el fondo) se sumaba al propio "pb" de esta sección, dejando el
       negro de abajo mucho más alto que el de arriba aunque cada uno,
       por separado, midiera lo mismo (reportado repetidamente como
       "padding desbalanceado"). -->
  {
    related.length > 0 && (
      <section aria-label={t("journal.related")} data-carousel class="section-space -mb-16 bg-background sm:-mb-20 md:-mb-28">
        <div class="container-tight">
          <p class="reveal font-heading mb-8 text-2xl font-normal uppercase text-foreground sm:text-3xl">{t("journal.related")}</p>
          <!-- Sin "pb-2" (como antes): ese aire extra propio del track
               rompía la simetría exacta con el padding superior de la
               sección ("section-space" ya reserva el mismo espacio
               arriba y abajo por sí solo). -->
          <div data-carousel-track class="no-scrollbar flex snap-x snap-mandatory gap-6 overflow-x-auto">
            {related.map((r) => (
              <a href={journalArticlePath(locale, r.slug)} class="reveal group block w-[68%] shrink-0 snap-start text-left sm:w-[42%] lg:w-[28%]">
                <div class="aspect-[4/3] overflow-hidden bg-card">
                  <Image
                    src={servicePhotos(r.cover.service)[r.cover.index]}
                    alt={photoAlt(locale, r.title, r.cover.index)}
                    widths={[320, 480]}
                    sizes="(max-width: 640px) 68vw, 28vw"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
                <span class="font-heading mt-4 block text-base font-medium text-foreground">{r.title}</span>
                <p class="font-label mt-1 text-xs font-medium text-foreground uppercase">{r.category}</p>
                <p class="font-label text-xs text-neutral-500 uppercase">{r.date}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <script>
    import "@/scripts/testimonial-carousel";
    import "@/scripts/drag-scroll";
  </script>
</BaseLayout>
