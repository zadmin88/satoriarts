---
import GridMediaItem, { type GridItem } from "@/components/GridMediaItem.astro";
import type { ServiceKey } from "@/config";
import { useT } from "@/i18n/ui";
import type { Locale } from "@/config";

/**
 * Bloque "PROYECTOS + barra de categorías + cuadrícula", ÚNICO
 * componente compartido por /proyectos/ (PortfolioPage.astro, las 4
 * categorías a la vez con filtro CSS :has()) y cada página de servicio
 * (ServiceLayout.astro, /bodas/, /eventos/...). Con un único componente,
 * cualquier ajuste de spacing/sticky/grid se hace aquí una sola vez.
 *
 * La ÚNICA pieza que no se unifica son las propias pestañas: en
 * /proyectos/ son radios+<label> (filtrado 100% CSS con :has(), sin
 * recargar); en cada página de servicio son <a> reales (cada servicio es
 * su propia URL indexable para el SEO local). Por eso llegan por el slot
 * "filters": la envoltura (bleed, padding, gap) es idéntica en las 5.
 */

export interface ServiceBlock {
  key: ServiceKey;
  photos: GridItem[];
  photoColumns: [GridItem[], GridItem[]];
}

interface Props {
  locale: Locale;
  blocks: ServiceBlock[];
  /** Solo /proyectos/ lo necesita: filter-scroll.ts hace scroll hasta
   *  aquí al cambiar de filtro por radio. */
  withGridId?: boolean;
}

const { locale, blocks, withGridId = false } = Astro.props;
const t = useT(locale);
---

<!-- "filter-gallery" envuelve título + barra + cuadrícula: el filtrado
     CSS (:has() en global.css) necesita que los radios de la barra y las
     fotos [data-service] compartan este mismo ancestro. -->
<div class="filter-gallery">
  <!-- Título "PROYECTOS" en FLUJO NORMAL: se va con el scroll y
       desaparece tras el header (fijo y opaco). Antes vivía DENTRO del
       bloque sticky y se colapsaba con ".is-stuck" (IntersectionObserver
       + centinela) al quedar pegado. Ese colapso —cambiar la altura de
       un elemento en flujo— empujaba el grid de golpe (salto), y en
       móvil la barra de direcciones al mostrarse/ocultarse hacía oscilar
       ese colapso una y otra vez (el "salto al empezar a hacer scroll"
       reportado). Con el título en flujo normal desaparece de forma
       natural, sin colapso, sin salto y sin oscilación. Sigue siendo el
       ÚNICO <h1> de la página (en /bodas/, /eventos/... también). -->
  <div class="container-tight pt-5 pb-4 md:pt-6 md:pb-5">
    <h1 class="font-heading text-3xl font-normal uppercase text-foreground sm:text-5xl">{t("nav.portfolio")}</h1>
  </div>

  <!-- SOLO la barra de categorías es sticky, pegada justo bajo el header
       (fixed, 6rem móvil / 7rem desktop). top-[calc(...-1px)]: 1px de
       solape con el borde inferior del header para evitar una costura
       por redondeo de subpíxeles. z-40 (el header es z-50): la barra
       pasa por debajo del header. bg-black: cubre las fotos que pasan por
       debajo al hacer scroll. Sticky (no fixed): se libera solo al
       terminar la cuadrícula (fin de .filter-gallery), sin spacer. -->
  <div data-fixed-header class="projects-sticky-bar sticky z-40 bg-black">
    <!-- Bug de WebKit/Safari (iOS): si el propio elemento con
         "overflow-x: auto" tiene padding-inline, Safari lo ignora al
         calcular el reposo del scroll y el contenido queda pegado al
         borde. Fix: el que scrollea (outer) sangra (-mx) y NO tiene
         padding; el padding lo pone el inner (.container-tight, misma
         clase que el título y el grid). -->
    <!-- El scroller ocupa el ancho completo de la barra (= viewport),
         SIN margen negativo: antes usaba "-mx-5 sm:-mx-6" para sangrar a
         los bordes, pero como su padre ya es de ancho completo, ese -mx
         se pasaba ~1.25rem de cada borde y hacía que el documento fuera
         más ancho que la pantalla (scroll horizontal + el header fixed
         se descuadraba al ocultarse la barra del navegador). El track de
         scroll ya llega a los bordes por ser ancho completo; el padding
         (px) lo pone el .container-tight interior, que además evita el
         bug de Safari de ignorar el padding-inline del propio scroller. -->
    <div class="no-scrollbar overflow-x-auto">
      <div class="container-tight flex flex-nowrap gap-2 py-4 sm:flex-wrap md:py-5">
        <slot name="filters" />
      </div>
    </div>
  </div>

  <!-- CUADRÍCULA: masonry con 2 columnas EXPLÍCITAS (no CSS "columns-2").
       Mobile: una sola lista secuencial; desde "sm:", dos columnas
       repartidas por índice dentro de cada categoría. -->
  <div data-portfolio-grid={withGridId ? true : undefined} class="container-tight pb-24 pt-1 md:pt-2">
    {
      blocks.map((block) => (
        <div data-service={block.key}>
          {/* Fotos: 1 columna en mobile, 2 en desktop */}
          <div class="mb-6 flex flex-col gap-6 sm:mb-10 sm:hidden">
            {block.photos.map((item) => (
              <GridMediaItem item={item} />
            ))}
          </div>
          <div class="mb-10 hidden gap-x-6 sm:grid sm:grid-cols-2 sm:items-start">
            {block.photoColumns.map((col) => (
              <div class="flex flex-col gap-6">
                {col.map((item) => (
                  <GridMediaItem item={item} />
                ))}
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
