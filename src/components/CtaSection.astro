---
import { waLink } from "@/config";
import type { Locale } from "@/config";
import { useT } from "@/i18n/ui";

interface Props {
  locale: Locale;
  /** Mensaje de WhatsApp prellenado */
  message: string;
}

const { locale, message } = Astro.props;
const t = useT(locale);
---

<section aria-labelledby="cta-titulo" class="bg-card/60">
  <div class="section-space container-prose flex flex-col items-start gap-6 text-left sm:items-center sm:text-center">
    <div class="reveal flex flex-col gap-3">
      <h2 id="cta-titulo" class="font-heading text-4xl font-medium text-foreground sm:text-5xl">
        {t("cta.blockTitle")}
      </h2>
      <p class="text-lg leading-relaxed text-muted-foreground sm:mx-auto sm:max-w-xl">{t("cta.blockText")}</p>
    </div>
    <a
      href={waLink(message)}
      target="_blank"
      rel="noopener"
      class="reveal inline-flex h-12 items-center justify-center rounded-sm bg-white px-7 text-black transition-colors hover:bg-white/90"
    >
      <span class="hover-flip inline-block">
        <span class="flip-a block text-sm font-semibold uppercase tracking-[0.06em]">{t("cta.requestInfo")}</span>
        <span aria-hidden="true" class="flip-b block text-sm font-semibold uppercase tracking-[0.06em]">{t("cta.requestInfo")}</span>
      </span>
    </a>
  </div>
</section>
