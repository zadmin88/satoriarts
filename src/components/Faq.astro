---
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div>
  {
    items.map((item) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-foreground [&::-webkit-details-marker]:hidden">
          {item.q}
          <span class="plus-icon shrink-0 text-foreground" aria-hidden="true" />
        </summary>
        <p class="pt-3 text-muted-foreground" set:html={item.a} />
      </details>
    ))
  }
</div>
