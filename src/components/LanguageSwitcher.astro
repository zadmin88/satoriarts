---
import { LOCALES, LOCALE_LABEL } from "@/config";
import type { Locale } from "@/config";
import { useT } from "@/i18n/ui";

interface Props {
  locale: Locale;
  /** Ruta equivalente en cada idioma */
  alternates: Record<Locale, string>;
}

const { locale, alternates } = Astro.props;
const t = useT(locale);
---

<nav aria-label={t("a11y.langMenu")} class="flex items-center gap-0.5 text-sm">
  {
    LOCALES.map((l, i) => (
      <>
        {i > 0 && <span aria-hidden="true" class="text-border">·</span>}
        <a
          href={alternates[l]}
          hreflang={l}
          aria-current={l === locale ? "true" : undefined}
          class:list={[
            "rounded px-1.5 py-1 font-medium transition-colors",
            l === locale
              ? "text-gold"
              : "text-muted-foreground hover:text-foreground",
          ]}
        >
          {LOCALE_LABEL[l]}
        </a>
      </>
    ))
  }
</nav>
