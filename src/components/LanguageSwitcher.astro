---
import { LOCALES, LOCALE_LABEL, LOCALE_NAME } from "@/config";
import type { Locale } from "@/config";
import { useT } from "@/i18n/ui";

interface Props {
  locale: Locale;
  /** Ruta equivalente en cada idioma */
  alternates: Record<Locale, string>;
  /** "inline" (por defecto): ES · EN · CA en línea. "dropdown": icono de globo con menú desplegable. */
  variant?: "inline" | "dropdown";
}

const { locale, alternates, variant = "inline" } = Astro.props;
const t = useT(locale);
---

{
  variant === "dropdown" ? (
    <details class="group relative">
      <summary
        class="flex h-10 shrink-0 cursor-pointer list-none items-center gap-1.5 select-none md:h-12 [&::-webkit-details-marker]:hidden"
        aria-label={t("a11y.langMenu")}
      >
        <span class="font-nav text-sm font-medium tracking-[0.06em] text-white uppercase">{LOCALE_LABEL[locale]}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-2.5 rotate-90 text-white transition-transform group-open:-rotate-90"><path d="M8 5v14l11-7z"/></svg>
      </summary>
      <nav
        aria-label={t("a11y.langMenu")}
        class="lang-dropdown absolute top-full right-0 z-40 mt-3 flex w-52 flex-col gap-1 p-1"
      >
        {
          LOCALES.filter((l) => l !== locale).map((l) => (
            <a
              href={alternates[l]}
              hreflang={l}
              class="font-nav flex items-center justify-between gap-4 rounded-sm px-3 py-2.5 text-xs tracking-wide text-white/80 uppercase transition-colors hover:text-white"
            >
              <span>{LOCALE_NAME[l]}</span>
              <span class="text-white/60">{LOCALE_LABEL[l]}</span>
            </a>
          ))
        }
      </nav>
    </details>
  ) : (
    <nav aria-label={t("a11y.langMenu")} class="flex items-center gap-0.5 text-sm">
      {
        LOCALES.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="text-border">·</span>}
            <a
              href={alternates[l]}
              hreflang={l}
              aria-current={l === locale ? "true" : undefined}
              class:list={[
                "rounded px-1.5 py-1 font-medium",
                l === locale ? "text-foreground" : "hover-flip text-muted-foreground",
              ]}
            >
              {l === locale ? (
                LOCALE_LABEL[l]
              ) : (
                <>
                  <span class="flip-a block">{LOCALE_LABEL[l]}</span>
                  <span aria-hidden="true" class="flip-b block text-foreground">{LOCALE_LABEL[l]}</span>
                </>
              )}
            </a>
          </>
        ))
      }
    </nav>
  )
}
