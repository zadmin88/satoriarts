---
import CityServicePage from "@/components/pages/CityServicePage.astro";
import { cityServiceCombos } from "@/i18n/city-service";

export function getStaticPaths() {
  return cityServiceCombos("en").map((combo) => ({
    params: { slug: combo.slug },
    props: { serviceKey: combo.serviceKey, citySlug: combo.citySlug },
  }));
}

const { serviceKey, citySlug } = Astro.props;
---

<CityServicePage locale="en" serviceKey={serviceKey} citySlug={citySlug} />
